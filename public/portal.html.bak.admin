<!doctype html>
<html lang="en" dir="ltr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="theme-color" content="#0B0B0C">
<title>TotemTime</title>
<link rel="icon" href="/assets/brand/favicon.ico">
<link rel="icon" type="image/png" sizes="32x32" href="/assets/brand/favicon-32.png">
<link rel="apple-touch-icon" href="/assets/brand/apple-touch-icon.png">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800&family=Heebo:wght@400;500;700;800&display=swap" rel="stylesheet">
<style>
/* ============================================================
   TotemTime — design tokens (from the Figma "Color" sheet)
   Change a value here and it changes everywhere. Same palette
   the game engine uses, so portal and game read as one product.
   ============================================================ */
:root{
  /* neutrals */
  --black:#000000; --white:#ffffff;
  --ltc-700:#191B1F; --ltc-600:#373D40; --ltc-500:#5E6366; --ltc-400:#6B6F89;
  --ltc-300:#A5AABE; --ltc-200:#C9CCD8; --ltc-100:#DBDDE5; --ltc-50:#F9F8F8;

  /* primary (lime) */
  --p-700:#34410E; --p-600:#ADCB53; --p-500:#D0F267; --p-400:#D9F585;
  --p-300:#E3F7A4; --p-200:#ECFAC2; --p-100:#F1FBD1; --p-50:#F6FCE1;

  /* blue */
  --b-700:#214878; --b-600:#417FD1; --b-500:#519BFC; --b-400:#74AFFD;
  --b-300:#97C3FD; --b-200:#B9D7FE; --b-100:#B9D7FE; --b-50:#EEF5FF;

  /* semantic */
  --danger:#F64C4C; --danger-700:#2E1009; --danger-50:#FCEDEA;
  --warning:#FFAD0D; --warning-700:#FE9B0E; --warning-50:#FFFDFA;
  --success:var(--p-500);

  /* surfaces */
  --bg:#0B0B0C;
  --surface:#141416;
  --surface-2:#1E1E20;
  --surface-3:#282829;
  --hairline:rgba(255,255,255,.08);
  --hairline-2:rgba(255,255,255,.14);

  /* type */
  --font:'Outfit','Heebo',system-ui,-apple-system,'Segoe UI',sans-serif;
  --font-he:'Heebo','Outfit',system-ui,sans-serif;

  /* shape */
  --r-xs:10px; --r-sm:14px; --r-md:18px; --r-lg:24px; --r-xl:32px; --r-pill:999px;

  /* spacing rhythm */
  --gap:14px; --pad:18px;

  /* layout */
  --rail:264px;
  --shell-max:1180px;
  --safe-b:env(safe-area-inset-bottom,0px);
  --safe-t:env(safe-area-inset-top,0px);
}

/* ============================================================
   base
   ============================================================ */
*,*::before,*::after{box-sizing:border-box}
html,body{height:100%}
body{
  margin:0; background:var(--bg); color:var(--ltc-50);
  font-family:var(--font); font-size:16px; line-height:1.45;
  -webkit-font-smoothing:antialiased; text-rendering:optimizeLegibility;
  overscroll-behavior-y:none;
}
html[dir="rtl"] body{font-family:var(--font-he)}
img,video{max-width:100%;display:block}
button,input,select,textarea{font:inherit;color:inherit}
a{color:var(--p-500);text-decoration:none}
h1,h2,h3,h4,p{margin:0}
:focus-visible{outline:2px solid var(--p-500);outline-offset:2px;border-radius:6px}
.hide{display:none !important}
.sr{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}

/* ============================================================
   type scale
   ============================================================ */
.display{font-size:clamp(30px,7vw,44px);font-weight:800;letter-spacing:-.02em;line-height:1.05}
.h1{font-size:26px;font-weight:700;letter-spacing:-.015em}
.h2{font-size:20px;font-weight:700;letter-spacing:-.01em}
.h3{font-size:17px;font-weight:600}
.body{font-size:15px}
.small{font-size:13.5px}
.tiny{font-size:12px;letter-spacing:.01em}
.muted{color:var(--ltc-400)}
.dim{color:var(--ltc-300)}
.lime{color:var(--p-500)}
.center{text-align:center}

/* ============================================================
   buttons
   ============================================================ */
.btn{
  -webkit-appearance:none;appearance:none;border:0;cursor:pointer;
  display:inline-flex;align-items:center;justify-content:center;gap:9px;
  min-height:52px;padding:0 22px;border-radius:var(--r-md);
  font-weight:700;font-size:15.5px;letter-spacing:.005em;
  background:var(--p-500);color:#12160A;
  transition:transform .12s ease,filter .16s ease,background .16s ease;
  user-select:none;-webkit-tap-highlight-color:transparent;
}
.btn:hover{filter:brightness(1.06)}
.btn:active{transform:scale(.975)}
.btn[disabled]{opacity:.4;pointer-events:none}
.btn.block{width:100%}
.btn.sm{min-height:40px;padding:0 16px;font-size:14px;border-radius:var(--r-sm)}
.btn.xs{min-height:34px;padding:0 13px;font-size:13px;border-radius:var(--r-xs);gap:6px}
.btn.ghost{background:var(--surface-2);color:var(--ltc-50);box-shadow:inset 0 0 0 1px var(--hairline)}
.btn.ghost:hover{background:var(--surface-3)}
.btn.blue{background:var(--b-500);color:#06121F}
.btn.danger{background:transparent;color:var(--danger);box-shadow:inset 0 0 0 1px rgba(246,76,76,.45)}
.btn.danger:hover{background:rgba(246,76,76,.1)}
.btn.solid-danger{background:var(--danger);color:#fff}
.btn.link{background:none;min-height:auto;padding:0;color:var(--p-500);font-weight:600;font-size:14px}
.btn.link:hover{filter:none;text-decoration:underline}

/* ============================================================
   inputs
   ============================================================ */
.field{display:block;margin-bottom:var(--gap)}
.field > .label{display:block;font-size:13px;font-weight:600;color:var(--ltc-300);margin:0 2px 7px}
.input,.select,.textarea{
  width:100%;min-height:52px;padding:14px 16px;
  background:var(--surface-2);border:1px solid var(--hairline);
  border-radius:var(--r-md);color:var(--ltc-50);font-size:16px;
  transition:border-color .16s ease,background .16s ease;
}
.textarea{min-height:110px;resize:vertical;line-height:1.5}
.input::placeholder,.textarea::placeholder{color:var(--ltc-500)}
.input:focus,.select:focus,.textarea:focus{outline:none;border-color:var(--p-500);background:var(--surface-3)}
.input.err{border-color:var(--danger)}
.select{
  -webkit-appearance:none;appearance:none;padding-inline-end:42px;
  background-image:linear-gradient(45deg,transparent 50%,var(--ltc-300) 50%),linear-gradient(135deg,var(--ltc-300) 50%,transparent 50%);
  background-position:right 20px center,right 14px center;background-size:6px 6px,6px 6px;background-repeat:no-repeat;
}
html[dir="rtl"] .select{background-position:left 14px center,left 20px center;
  background-image:linear-gradient(135deg,transparent 50%,var(--ltc-300) 50%),linear-gradient(45deg,var(--ltc-300) 50%,transparent 50%);}
.hint{font-size:12.5px;color:var(--ltc-500);margin:6px 2px 0}
.hint.err{color:var(--danger)}

/* ============================================================
   cards
   ============================================================ */
.card{background:var(--surface);border:1px solid var(--hairline);border-radius:var(--r-lg);padding:var(--pad)}
.card.flush{padding:0;overflow:hidden}
.card.lime{background:var(--p-500);border-color:transparent;color:#12160A}
.card.lime .muted,.card.lime .dim{color:rgba(18,22,10,.62)}
.card.tight{padding:14px}
.stack{display:flex;flex-direction:column;gap:var(--gap)}
.row{display:flex;align-items:center;gap:12px}
.row.between{justify-content:space-between}
.row.wrap{flex-wrap:wrap}
.grow{flex:1;min-width:0}
.sep{height:1px;background:var(--hairline);margin:2px 0}
.truncate{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}

/* chips / badges */
.chip{
  display:inline-flex;align-items:center;gap:6px;padding:6px 12px;border-radius:var(--r-pill);
  background:var(--surface-2);color:var(--ltc-200);font-size:12.5px;font-weight:600;
  box-shadow:inset 0 0 0 1px var(--hairline);white-space:nowrap;
}
.chip.lime{background:rgba(208,242,103,.14);color:var(--p-500);box-shadow:inset 0 0 0 1px rgba(208,242,103,.3)}
.chip.blue{background:rgba(81,155,252,.14);color:var(--b-400);box-shadow:inset 0 0 0 1px rgba(81,155,252,.3)}
.chip.warn{background:rgba(255,173,13,.14);color:var(--warning);box-shadow:inset 0 0 0 1px rgba(255,173,13,.3)}
.chip.dead{background:var(--surface-2);color:var(--ltc-500)}
.dot{width:7px;height:7px;border-radius:50%;background:currentColor;flex:none}

/* ============================================================
   app shell
   ============================================================ */
.appbar{
  position:sticky;top:0;z-index:40;
  padding:calc(var(--safe-t) + 12px) 16px 12px;
  background:linear-gradient(180deg,var(--bg) 72%,rgba(11,11,12,0));
}
.appbar .row{gap:10px}
.brand{display:flex;align-items:center;gap:9px;font-weight:800;letter-spacing:-.02em;font-size:18px}
.brand .mark{
  width:30px;height:30px;border-radius:9px;flex:none;
  background:var(--p-500);color:#12160A;display:grid;place-items:center;font-size:15px;font-weight:800;
}
.iconbtn{
  width:40px;height:40px;border-radius:var(--r-sm);flex:none;border:0;cursor:pointer;
  background:var(--surface-2);color:var(--ltc-200);display:grid;place-items:center;
  box-shadow:inset 0 0 0 1px var(--hairline);font-size:15px;font-weight:600;
}
.iconbtn:hover{background:var(--surface-3);color:var(--ltc-50)}

main{padding:4px 16px 132px;max-width:var(--shell-max);margin:0 auto}
.view{animation:fade .22s ease}
@keyframes fade{from{opacity:0;transform:translateY(6px)}to{opacity:1;transform:none}}
.page-title{margin:6px 2px 16px}

/* bottom nav (mobile) */
.tabbar{
  position:fixed;inset-inline:0;bottom:0;z-index:50;
  display:grid;grid-auto-flow:column;grid-auto-columns:1fr;
  padding:10px 8px calc(10px + var(--safe-b));
  background:rgba(15,15,17,.86);backdrop-filter:blur(18px);
  border-top:1px solid var(--hairline);
}
.tab{
  background:none;border:0;cursor:pointer;padding:7px 4px;border-radius:var(--r-sm);
  display:flex;flex-direction:column;align-items:center;gap:4px;
  color:var(--ltc-400);font-size:11px;font-weight:600;letter-spacing:.01em;
}
.tab svg{width:22px;height:22px;stroke:currentColor;fill:none;stroke-width:1.7;stroke-linecap:round;stroke-linejoin:round}
.tab.on{color:var(--p-500)}
.tab .lbl{max-width:100%;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.backarrow{display:inline-block}
html[dir="rtl"] .backarrow{transform:scaleX(-1)}
@media (max-width:420px){ .tab{font-size:10px} .tab svg{width:21px;height:21px} }

/* side rail (desktop) */
.rail{display:none}

/* ============================================================
   game cards
   ============================================================ */
.gamecard{position:relative;background:var(--surface);border:1px solid var(--hairline);border-radius:var(--r-lg);overflow:hidden}
.gamecard .cover{
  aspect-ratio:16/9;background:var(--surface-3) center/cover no-repeat;position:relative;
}
.gamecard .cover::after{content:"";position:absolute;inset:0;background:linear-gradient(180deg,rgba(0,0,0,0) 35%,rgba(0,0,0,.72))}
.gamecard .cover .over{position:absolute;inset-inline:14px;bottom:12px;z-index:2;display:flex;gap:8px;align-items:flex-end;justify-content:space-between}
.gamecard .body{padding:16px}
.gamecard .body .h2{margin-bottom:4px}
.progress{height:6px;border-radius:var(--r-pill);background:var(--surface-3);overflow:hidden}
.progress > i{display:block;height:100%;background:var(--p-500);border-radius:inherit;transition:width .4s ease}

/* store */
.pricetag{font-size:26px;font-weight:800;letter-spacing:-.02em}
.seatpick{display:flex;gap:8px;flex-wrap:wrap}
.seatpick .opt{
  flex:1;min-width:78px;cursor:pointer;border-radius:var(--r-md);padding:11px 8px;text-align:center;
  background:var(--surface-2);box-shadow:inset 0 0 0 1px var(--hairline);
  font-weight:700;font-size:15px;transition:.15s;
}
.seatpick .opt small{display:block;font-weight:500;font-size:11.5px;color:var(--ltc-400);margin-top:2px}
.seatpick .opt.on{background:rgba(208,242,103,.13);box-shadow:inset 0 0 0 1.5px var(--p-500);color:var(--p-500)}
.seatpick .opt.on small{color:var(--p-600)}

/* coupons */
.coupon{
  position:relative;border-radius:var(--r-lg);padding:16px 18px;overflow:hidden;
  background:linear-gradient(135deg,var(--p-500),var(--p-400));color:#12160A;
}
.coupon.used{background:var(--surface-2);color:var(--ltc-400);box-shadow:inset 0 0 0 1px var(--hairline)}
.coupon .code{
  font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-weight:700;font-size:17px;letter-spacing:.09em;
  background:rgba(0,0,0,.14);border-radius:var(--r-xs);padding:8px 12px;display:inline-flex;align-items:center;gap:10px;
}
.coupon.used .code{background:var(--surface-3)}
.coupon::before,.coupon::after{
  content:"";position:absolute;width:22px;height:22px;border-radius:50%;background:var(--bg);
  inset-inline-start:-11px;
}
.coupon::before{top:calc(50% - 11px)}
.coupon::after{inset-inline-start:auto;inset-inline-end:-11px;top:calc(50% - 11px)}

/* avatars */
.avatar{
  border-radius:50%;display:grid;place-items:center;flex:none;
  width:44px;height:44px;font-size:22px;line-height:1;
  background:var(--surface-3);box-shadow:inset 0 0 0 1px var(--hairline);
}
.avatar.lg{width:84px;height:84px;font-size:40px}
.avatar.sm{width:34px;height:34px;font-size:17px}
.avgrid{display:grid;grid-template-columns:repeat(auto-fill,minmax(58px,1fr));gap:10px}
.avgrid button{
  aspect-ratio:1;border:0;cursor:pointer;border-radius:50%;font-size:26px;
  background:var(--surface-2);box-shadow:inset 0 0 0 1px var(--hairline);transition:.15s;
}
.avgrid button.on{box-shadow:inset 0 0 0 2.5px var(--p-500);background:rgba(208,242,103,.12)}

/* invite list rows */
.rowitem{display:flex;align-items:center;gap:12px;padding:13px 0}
.rowitem + .rowitem{border-top:1px solid var(--hairline)}
.seatbar{display:flex;gap:5px;flex-wrap:wrap}
.seatbar i{width:22px;height:6px;border-radius:var(--r-pill);background:var(--surface-3)}
.seatbar i.on{background:var(--p-500)}

/* empty state */
.empty{text-align:center;padding:44px 20px}
.empty .ic{font-size:40px;margin-bottom:12px;opacity:.85}

/* skeleton */
.sk{background:linear-gradient(90deg,var(--surface-2) 25%,var(--surface-3) 37%,var(--surface-2) 63%);
  background-size:400% 100%;animation:shim 1.3s ease infinite;border-radius:var(--r-md)}
@keyframes shim{0%{background-position:100% 0}100%{background-position:0 0}}

/* ============================================================
   modal / sheet
   ============================================================ */
.scrim{position:fixed;inset:0;z-index:80;background:rgba(0,0,0,.66);backdrop-filter:blur(3px);
  display:flex;align-items:flex-end;justify-content:center;animation:fade .18s ease}
.sheet{
  width:100%;max-width:540px;max-height:88vh;overflow:auto;
  background:var(--surface);border:1px solid var(--hairline-2);
  border-radius:var(--r-xl) var(--r-xl) 0 0;padding:18px 18px calc(22px + var(--safe-b));
  animation:up .24s cubic-bezier(.2,.8,.25,1);
}
@keyframes up{from{transform:translateY(26px);opacity:.4}to{transform:none;opacity:1}}
.sheet .grip{width:44px;height:4px;border-radius:var(--r-pill);background:var(--surface-3);margin:0 auto 14px}

/* toast */
.toast{
  position:fixed;z-index:90;inset-inline:16px;bottom:calc(96px + var(--safe-b));margin:0 auto;max-width:420px;
  background:var(--surface-3);border:1px solid var(--hairline-2);border-radius:var(--r-md);
  padding:13px 16px;font-size:14px;font-weight:500;box-shadow:0 12px 34px rgba(0,0,0,.5);
  animation:up .2s ease;
}
.toast.ok{border-color:rgba(208,242,103,.5)}
.toast.bad{border-color:rgba(246,76,76,.6);color:#FFD9D4}

/* share targets */
.sharegrid{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;text-align:center}
.sharegrid button{background:none;border:0;cursor:pointer;color:var(--ltc-200);font-size:12px;font-weight:600}
.sharegrid .bub{width:56px;height:56px;border-radius:50%;margin:0 auto 8px;display:grid;place-items:center;
  font-size:24px;background:var(--surface-2);box-shadow:inset 0 0 0 1px var(--hairline)}

/* auth screen */
.authwrap{min-height:100dvh;display:flex;flex-direction:column;justify-content:center;
  padding:32px 20px calc(32px + var(--safe-b));max-width:440px;margin:0 auto}
.authwrap .logo{width:64px;height:64px;border-radius:20px;background:var(--p-500);color:#12160A;
  display:grid;place-items:center;font-size:30px;font-weight:800;margin:0 auto 20px}
.seg{display:flex;gap:6px;background:var(--surface-2);border-radius:var(--r-md);padding:5px;margin-bottom:20px}
.seg button{flex:1;border:0;background:none;cursor:pointer;padding:11px;border-radius:var(--r-sm);
  color:var(--ltc-400);font-weight:600;font-size:14.5px}
.seg button.on{background:var(--surface-3);color:var(--ltc-50)}

/* uploader */
.drop{
  border:1.5px dashed var(--hairline-2);border-radius:var(--r-md);padding:18px;text-align:center;
  background:var(--surface-2);cursor:pointer;transition:.15s;
}
.drop:hover{border-color:var(--p-500);background:var(--surface-3)}
.thumb{width:100%;aspect-ratio:16/9;object-fit:cover;border-radius:var(--r-md);background:var(--surface-3)}

/* ============================================================
   desktop
   ============================================================ */
@media (min-width:900px){
  :root{--pad:22px;--gap:16px}
  #root{display:grid;grid-template-columns:var(--rail) 1fr;align-items:start;min-height:100dvh}
  body.auth-mode #root{display:block}
  .tabbar{display:none}
  .rail{
    display:flex;flex-direction:column;gap:6px;position:sticky;top:0;height:100dvh;
    padding:26px 16px;border-inline-end:1px solid var(--hairline);background:var(--surface);
  }
  .rail .brand{margin:0 8px 26px;font-size:20px}
  .rail .navbtn{
    display:flex;align-items:center;gap:12px;padding:12px 14px;border-radius:var(--r-md);
    border:0;background:none;cursor:pointer;color:var(--ltc-300);font-weight:600;font-size:15px;text-align:start;
  }
  .rail .navbtn svg{width:21px;height:21px;stroke:currentColor;fill:none;stroke-width:1.7;stroke-linecap:round;stroke-linejoin:round;flex:none}
  .rail .navbtn:hover{background:var(--surface-2);color:var(--ltc-50)}
  .rail .navbtn.on{background:rgba(208,242,103,.12);color:var(--p-500)}
  .rail .foot{margin-top:auto;display:flex;flex-direction:column;gap:10px}
  .appbar{padding:26px 30px 14px;background:none;position:static}
  .appbar > .row{display:none}
  main{padding:0 30px 60px}
  .page-title{margin:0 0 22px}
  .cols{display:grid;grid-template-columns:repeat(auto-fill,minmax(330px,1fr));gap:var(--gap);align-items:start}
  .cols-2{display:grid;grid-template-columns:minmax(0,1.4fr) minmax(0,1fr);gap:var(--gap);align-items:start}
  .scrim{align-items:center}
  .sheet{border-radius:var(--r-xl);padding:24px;max-height:84vh}
  .toast{bottom:26px}
  .authwrap{grid-column:1/-1}
}
@media (max-width:899px){
  .cols,.cols-2{display:flex;flex-direction:column;gap:var(--gap)}
}
@media (prefers-reduced-motion:reduce){*{animation:none !important;transition:none !important}}
</style>
</head>
<body class="auth-mode">
<div id="root"></div>
<div id="layer"></div>

<script type="module">
/* ================================================================
   TotemTime — Portal
   Single page, hash routes, no build step. Firebase Web SDK via CDN.

   Principle carried over from the engine: DATA, NOT CODE.
     - every user-facing string is a KEY  -> I18N
     - what a Director may customize is a MANIFEST on the game doc
     - roles/capabilities come from the instance, not from the code
   ================================================================ */

import { initializeApp } from "https://www.gstatic.com/firebasejs/10.12.2/firebase-app.js";
import {
  getAuth, onAuthStateChanged, signInWithEmailAndPassword, createUserWithEmailAndPassword,
  sendPasswordResetEmail, signOut, updateProfile, deleteUser,
  EmailAuthProvider, reauthenticateWithCredential
} from "https://www.gstatic.com/firebasejs/10.12.2/firebase-auth.js";
import {
  getFirestore, doc, getDoc, setDoc, updateDoc, deleteDoc, collection, getDocs,
  query, where, addDoc, serverTimestamp, arrayUnion
} from "https://www.gstatic.com/firebasejs/10.12.2/firebase-firestore.js";
import { getStorage, ref as sRef, uploadBytes, getDownloadURL }
  from "https://www.gstatic.com/firebasejs/10.12.2/firebase-storage.js";
import { getFunctions, httpsCallable }
  from "https://www.gstatic.com/firebasejs/10.12.2/firebase-functions.js";

import { firebaseConfig } from "./config.js";

const app  = initializeApp(firebaseConfig);
const auth = getAuth(app);
const db   = getFirestore(app);
const store= getStorage(app);
const fns  = getFunctions(app);

/* ================================================================
   1. STRINGS — every visible word is a key.
   Add a language = add a block below (and a LANGS entry). No other
   code changes. Missing keys fall back to English, never a raw key.
   ================================================================ */
const LANGS = [
  { code:"en", label:"English",  dir:"ltr" },
  { code:"he", label:"עברית",    dir:"rtl" }
];

const I18N = {
  en: {
    "app.name":"TotemTime",
    "app.tagline":"Escape together. Anywhere.",

