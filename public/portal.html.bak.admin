const AVATARS = ["🦊","🐺","🦉","🐙","🦁","🐨","🐸","🦄","🐲","🦅","🐯","🐼","👻","🤖","🎭","🕵️"];

/* ================================================================
   2. Small helpers
   ================================================================ */
const $  = (s,r=document)=>r.querySelector(s);
const root  = $("#root");
const layer = $("#layer");

const S = {                       // app state
  lang: localStorage.getItem("tt.lang") || "en",
  user: null,                     // firebase auth user
  profile: null,                  // users/{uid}
  instances: [],                  // purchases this user can see (+ .game, .role)
  gamesById: {},                  // games/{id} cache
  localesCache: {},               // `${gameId}:${lang}` -> map
  catalog: [],                    // store listings
  route: { name:"games", args:[] },
  busy: false
};

function t(key, vars){
  const dict = I18N[S.lang] || {};
  let s = dict[key] ?? I18N.en[key] ?? key;
  if (vars) for (const k in vars) s = s.split("{"+k+"}").join(vars[k]);
  return s;
}
const esc = v => String(v ?? "").replace(/[&<>"']/g, c =>
  ({ "&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;" }[c]));

function setLang(code){
  S.lang = code;
  localStorage.setItem("tt.lang", code);
  const meta = LANGS.find(l=>l.code===code) || LANGS[0];
  document.documentElement.lang = code;
  document.documentElement.dir  = meta.dir;
  render();
}

const fmtDate = iso => {
  if (!iso) return "";
  const d = iso.toDate ? iso.toDate() : new Date(iso);
  if (isNaN(d)) return "";
  return d.toLocaleDateString(S.lang === "he" ? "he-IL" : "en-GB",
    { day:"numeric", month:"short", year:"numeric" });
};
const money = (cents, cur="usd") =>
  new Intl.NumberFormat(S.lang==="he"?"he-IL":"en-US",
    { style:"currency", currency:(cur||"usd").toUpperCase(), maximumFractionDigits:0 })
    .format((cents||0)/100);

function toast(msg, kind="ok"){
  const el = document.createElement("div");
  el.className = "toast " + kind;
  el.textContent = msg;
  layer.appendChild(el);
  setTimeout(()=>{ el.style.opacity="0"; el.style.transition="opacity .25s"; }, 2400);
  setTimeout(()=> el.remove(), 2750);
}

/* bottom sheet on mobile, centred modal on desktop — one function */
function sheet(innerHTML, onMount){
  closeSheet();
  const scrim = document.createElement("div");
  scrim.className = "scrim";
  scrim.innerHTML = `<div class="sheet" role="dialog" aria-modal="true">
      <div class="grip"></div>${innerHTML}</div>`;
  scrim.addEventListener("click", e => { if (e.target === scrim) closeSheet(); });
  layer.appendChild(scrim);
  document.body.style.overflow = "hidden";
  onMount && onMount(scrim);
  return scrim;
}
function closeSheet(){
  layer.querySelectorAll(".scrim").forEach(n=>n.remove());
  document.body.style.overflow = "";
}
document.addEventListener("keydown", e => { if (e.key === "Escape") closeSheet(); });

async function copy(text){
  try { await navigator.clipboard.writeText(text); }
  catch { const ta=document.createElement("textarea"); ta.value=text;
          document.body.appendChild(ta); ta.select(); document.execCommand("copy"); ta.remove(); }
}

const ICONS = {
  games:'<svg viewBox="0 0 24 24"><rect x="2" y="6" width="20" height="12" rx="5"/><path d="M7 10v4M5 12h4M16 11h.01M18.5 13.5h.01"/></svg>',
  store:'<svg viewBox="0 0 24 24"><path d="M3 9h18l-1.4 9.3a2 2 0 0 1-2 1.7H6.4a2 2 0 0 1-2-1.7L3 9Z"/><path d="M8 9V7a4 4 0 0 1 8 0v2"/></svg>',
  coupons:'<svg viewBox="0 0 24 24"><path d="M3 9.5V7a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v2.5a2.5 2.5 0 0 0 0 5V17a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-2.5a2.5 2.5 0 0 0 0-5Z"/><path d="M14 8.5 10 15.5"/></svg>',
  account:'<svg viewBox="0 0 24 24"><circle cx="12" cy="8" r="4"/><path d="M4.5 20a7.5 7.5 0 0 1 15 0"/></svg>',
  director:'<svg viewBox="0 0 24 24"><path d="M4 7h16v10H4z"/><path d="M4 11h16M9 7 7 17M15 7l-2 10"/></svg>'
};

/* ================================================================
   3. Auth screens
   ================================================================ */
let authMode = "signin";
let invitePrev = null, invitePrevReq = false;

function renderAuth(){
  document.body.classList.add("auth-mode");
  if (S.route && S.route.name === "join" && !invitePrevReq){
    invitePrevReq = true;
    const iid = S.route.args[0], tok = S.route.args[1];
    httpsCallable(fns, "getInvitePreview")({ instanceId: iid, token: tok })
      .then(r => {
        invitePrev = r.data || null;
        if (invitePrev){
          if (invitePrev.status === "pending") authMode = "signup";
          try{ if (invitePrev.language && invitePrev.language !== S.lang){ S.lang = invitePrev.language; setLangSilent(S.lang); } }catch(e){}
        }
        renderAuth();
      })
      .catch(e => console.warn("invite preview", e));
  }
  root.innerHTML = `
  <div class="authwrap">
    <div class="logo">TT</div>
    <h1 class="display center" style="margin-bottom:8px">${esc(t("app.name"))}</h1>
    <p class="body dim center" style="margin-bottom:26px">${esc(t("app.tagline"))}</p>
    ${invitePrev ? `<p class="body center" style="color:#c8f542;margin-bottom:18px">${esc(t("join.invited",{name:invitePrev.name||""}))}</p>` : ""}

    <div class="seg">
      <button class="${authMode==="signin"?"on":""}" data-act="mode" data-v="signin">${esc(t("auth.signin"))}</button>
      <button class="${authMode==="signup"?"on":""}" data-act="mode" data-v="signup">${esc(t("auth.signup"))}</button>
    </div>

    <form id="authform" class="stack" novalidate>
      ${authMode==="signup" ? `
      <label class="field"><span class="label">${esc(t("auth.name"))}</span>
        <input class="input" name="name" autocomplete="name" value="${esc((invitePrev&&invitePrev.name)||"")}" placeholder="${esc(t("auth.name.ph"))}" required>
      </label>` : ``}
      <label class="field"><span class="label">${esc(t("auth.email"))}</span>
        <input class="input" name="email" type="email" inputmode="email" autocomplete="email"
               value="${esc((invitePrev&&invitePrev.email)||"")}" ${invitePrev&&invitePrev.email?'readonly style="opacity:.75"':''}
               placeholder="${esc(t("auth.email.ph"))}" required>
      </label>
      <label class="field"><span class="label">${esc(t("auth.password"))}</span>
        <input class="input" name="password" type="password"
               autocomplete="${authMode==="signup"?"new-password":"current-password"}"
               placeholder="${esc(t("auth.password.ph"))}" required>
      </label>
      <p class="hint err hide" id="autherr"></p>
      <button class="btn block" type="submit">
        ${esc(authMode==="signin" ? t("auth.signin") : t("auth.signup"))}
      </button>
    </form>

    <div class="row between" style="margin-top:16px">
      <button class="btn link" data-act="forgot">${esc(t("auth.forgot"))}</button>
      <button class="btn link" data-act="langpick">${esc(LANGS.find(l=>l.code===S.lang).label)}</button>
    </div>
    <p class="tiny muted center" style="margin-top:24px">${esc(t("auth.accept"))}</p>
  </div>`;

  $("#authform").addEventListener("submit", async e => {
    e.preventDefault();
    const f = new FormData(e.target);
    const email = String(f.get("email")||"").trim();
    const pw    = String(f.get("password")||"");
    const name  = String(f.get("name")||"").trim();
    const err   = $("#autherr");
    const btn   = e.target.querySelector("button[type=submit]");
    err.classList.add("hide"); btn.disabled = true;
    try{
      if (authMode === "signup"){
        const cred = await createUserWithEmailAndPassword(auth, email, pw);
        if (name) await updateProfile(cred.user, { displayName: name });
        await ensureProfile(cred.user, { displayName: name });
      } else {
        await signInWithEmailAndPassword(auth, email, pw);
      }
    }catch(ex){
      err.textContent = authErr(ex);
      err.classList.remove("hide");
      btn.disabled = false;
    }
  });
}

function authErr(ex){
  const c = ex && ex.code || "";
  if (c.includes("email-already-in-use")) return t("auth.err.exists");
  if (c.includes("weak-password"))        return t("auth.err.weak");
  if (c.includes("invalid-credential") || c.includes("wrong-password") || c.includes("user-not-found"))
    return t("auth.err.invalid");
  return t("auth.err.generic");
}

/* ================================================================
   4. Data layer
   ================================================================ */
async function ensureProfile(user, extra={}){
  const ref  = doc(db, "users", user.uid);
  const snap = await getDoc(ref);
  if (!snap.exists()){
    const fresh = {
      uid:user.uid, email:user.email || "",
      displayName: extra.displayName || user.displayName || (user.email||"").split("@")[0],
      nickname: extra.displayName || user.displayName || "",
      avatar: AVATARS[Math.floor(Math.random()*AVATARS.length)],
      preferredLanguage: S.lang,
      accountType:"personal", companyName:null,
      createdAt: new Date().toISOString(),
      instances: [], history: [], coupons: []
    };
    await setDoc(ref, fresh);
    return fresh;
  }
  return snap.data();
}

async function loadGame(gameId){
  if (S.gamesById[gameId]) return S.gamesById[gameId];
  try{
    const snap = await getDoc(doc(db, "games", gameId));
    const data = snap.exists() ? { id:gameId, ...snap.data() } : { id:gameId };
    S.gamesById[gameId] = data;
    return data;
  }catch{ return { id:gameId }; }
}

/* game titles/labels also live as keys — resolve them from the game locale */
async function loadGameLocale(gameId, lang){
  const k = gameId + ":" + lang;
  if (S.localesCache[k]) return S.localesCache[k];
  try{
    const snap = await getDoc(doc(db,"games",gameId,"locales",lang));
    const m = snap.exists() ? snap.data() : {};
    S.localesCache[k] = m;
    return m;
  }catch{ S.localesCache[k] = {}; return {}; }
}

/* resolve a game-level key with fallback: chosen lang -> game default -> raw */
async function gt(game, key, fallback=""){
  if (!key) return fallback;
  const a = await loadGameLocale(game.id, S.lang);
  if (a[key] != null) return a[key];
  const def = game.defaultLanguage || "he";
  if (def !== S.lang){
    const b = await loadGameLocale(game.id, def);
    if (b[key] != null) return b[key];
  }
  return fallback || "";
}

async function loadEverything(){
  S.profile = await ensureProfile(S.user);
  if (S.profile.preferredLanguage && S.profile.preferredLanguage !== S.lang){
    S.lang = S.profile.preferredLanguage;
    localStorage.setItem("tt.lang", S.lang);
    const meta = LANGS.find(l=>l.code===S.lang) || LANGS[0];
    document.documentElement.lang = S.lang;
    document.documentElement.dir  = meta.dir;
  }

  const byId = new Map();

  // (a) games this user bought — they are the Director
  try{
    const owned = await getDocs(query(collection(db,"instances"), where("buyerUid","==",S.user.uid)));
    owned.forEach(d => byId.set(d.id, { id:d.id, ...d.data(), role:"director" }));
  }catch(e){ console.warn("owned instances", e); }

  // (b) games they were invited to — membership is recorded on their own user doc
  for (const id of (S.profile.instances || [])){
    if (byId.has(id)) continue;
    try{
      const d = await getDoc(doc(db,"instances",id));
      if (d.exists()) byId.set(id, { id, ...d.data(), role:"player" });
    }catch(e){ console.warn("instance", id, e); }
  }

  S.instances = [...byId.values()].filter(i => !i.archived);
  await Promise.all(S.instances.map(async i => { i.game = await loadGame(i.gameId); }));
  S.instances.sort((a,b)=> String(b.createdAt||"").localeCompare(String(a.createdAt||"")));

  // store catalog
  try{
    const snap = await getDocs(collection(db,"games"));
    S.catalog = [];
    snap.forEach(d => {
      const g = { id:d.id, ...d.data() };
      S.gamesById[d.id] = S.gamesById[d.id] || g;
      if (g.published !== false) S.catalog.push(g);
    });
  }catch(e){ console.warn("catalog", e); S.catalog = []; }
}

const isDirector = () => S.instances.some(i => i.role === "director");
const priceOf    = g => (g.store && g.store.price) ?? g.price ?? 0;
const currencyOf = g => (g.store && g.store.currency) || g.currency || "usd";
const seatOpts   = g => (g.store && g.store.seatOptions) || g.seatOptions || [4,6,8];
const coverOf    = g => (g.store && g.store.cover) || g.cover || g.hero || "";
const freeLaunch = g => !!(g.store && g.store.freeLaunch);

async function resolveTitles(){
  await Promise.all(S.instances.map(async i => {
    i.title = await gt(i.game, i.game.title_key, i.game.title || i.gameId);
  }));
  await Promise.all(S.catalog.map(async g => {
    g._title  = await gt(g, g.title_key,  g.title || g.id);
    g._blurb  = await gt(g, g.blurb_key || (g.store && g.store.blurb_key), (g.store && g.store.blurb) || g.blurb || "");
  }));
}

/* ================================================================
   5. Router
   ================================================================ */
const TABS = ["games","store","coupons","account"];

function parseHash(){
  const raw = (location.hash || "#/games").replace(/^#\/?/, "");
  const parts = raw.split("/").filter(Boolean);
  return { name: parts[0] || "games", args: parts.slice(1) };
}
function go(path){ location.hash = "#/" + path.replace(/^\/+/, ""); }
window.addEventListener("hashchange", () => { S.route = parseHash(); closeSheet(); render(); });

/* ================================================================
   6. Shell
   ================================================================ */
function shell(content){
  const dir = isDirector();
  const tabs = dir ? [...TABS.slice(0,3), "director", "account"] : TABS;
  const active = ["invites","customize","director"].includes(S.route.name) ? "director" : S.route.name;
  const av = (S.profile && S.profile.avatar) || "🎭";

  return `
  <nav class="rail" aria-label="Main">
    <div class="brand"><span class="mark">TT</span>${esc(t("app.name"))}</div>
    ${tabs.map(k=>`<button class="navbtn ${active===k?"on":""}" data-act="go" data-v="${k}">
        ${ICONS[k]}<span>${esc(t("nav."+k))}</span></button>`).join("")}
    <div class="foot">
      <button class="navbtn" data-act="langpick">🌐 <span>${esc(LANGS.find(l=>l.code===S.lang).label)}</span></button>
      <div class="row" style="padding:10px 14px;gap:10px">
        <div class="avatar sm">${esc(av)}</div>
        <div class="grow"><div class="small truncate" style="font-weight:600">${esc(nameOf())}</div>
          <div class="tiny muted truncate">${esc(S.user.email||"")}</div></div>
      </div>
    </div>
  </nav>

  <div>
    <header class="appbar">
      <div class="row between">
        <div class="brand"><span class="mark">TT</span>${esc(t("app.name"))}</div>
        <div class="row" style="gap:8px">
          <button class="iconbtn" data-act="langpick" aria-label="Language">🌐</button>
          <button class="iconbtn" data-act="go" data-v="account" aria-label="${esc(t("nav.account"))}">${esc(av)}</button>
        </div>
      </div>
    </header>
    <main>${content}</main>
  </div>

  <nav class="tabbar" aria-label="Main">
    ${tabs.map(k=>`<button class="tab ${active===k?"on":""}" data-act="go" data-v="${k}">
        ${ICONS[k]}<span class="lbl">${esc(t("nav."+k))}</span></button>`).join("")}
  </nav>`;
}

const nameOf = () => (S.profile && (S.profile.nickname || S.profile.displayName))
  || (S.user && S.user.displayName) || (S.user && (S.user.email||"").split("@")[0]) || "";

function pageTitle(title, sub, backTo){
  return `<div class="page-title">
    ${backTo ? `<button class="btn link" data-act="go" data-v="${backTo}" style="margin-bottom:10px"><span class="backarrow">←</span> ${esc(t("dir.back"))}</button>` : ""}
    <h1 class="h1">${esc(title)}</h1>
    ${sub ? `<p class="body muted" style="margin-top:4px">${esc(sub)}</p>` : ""}
  </div>`;
}
function emptyState(icon, title, body, ctaLabel, ctaRoute){
  return `<div class="card empty">
    <div class="ic">${icon}</div>
    <h3 class="h2" style="margin-bottom:6px">${esc(title)}</h3>
    <p class="body muted" style="max-width:34ch;margin:0 auto 18px">${esc(body)}</p>
    ${ctaLabel ? `<button class="btn" data-act="go" data-v="${ctaRoute}">${esc(ctaLabel)}</button>` : ""}
  </div>`;
}

/* ================================================================
   7. Views — Player
   ================================================================ */
function statusOf(inst){
  if (inst.status === "finished" || inst.finishedAt || inst.completedAt) return "done";
  if (inst.status === "played" || inst.playedAt) return "playing";
  return "ready";
}
/* customization on the banner: first image the director set is the cover; a badge marks it personalized */
function custCover(inst){
  const man = (inst.game && inst.game.customizable) || [];
  const c = inst.customization || {};
  for (const f of man) if (f.type === "image" && c[f.key]) return c[f.key];
  for (const k in c) if (/^https?:\/\//.test(String(c[k])) && /\.(png|jpe?g|webp|gif)(\?|$)/i.test(String(c[k]))) return c[k];
  return "";
}
function custTitleBits(inst){
  const man = (inst.game && inst.game.customizable) || [];
  const c = inst.customization || {};
  return man.filter(f => (f.type === "text" || !f.type) && c[f.key] && String(c[f.key]).trim() && String(c[f.key]).length <= 40)
            .slice(0, 2).map(f => String(c[f.key]).trim());
}
const isCustomized = inst => Object.values(inst.customization || {}).some(v => String(v||"").trim());

function ledgerLine(e){
  const ref = e.ref != null ? String(e.ref) : "";
  const k = e.kind;
  let txt = k === "hint" ? t("ledger.hint",{n:(e.idx||0)+1, ref}) : t("ledger."+k, {ref});
  if (txt === "ledger."+k) txt = k + (ref ? " " + ref : "");
  const pts = typeof e.points === "number" && e.points ? ` <b class="${e.points>0?"lime":""}" style="${e.points<0?"color:var(--danger)":""}">${e.points>0?"+":""}${e.points}</b>` : "";
  const tm = e.t ? new Date(e.t).toLocaleTimeString(S.lang==="he"?"he-IL":"en-GB",{hour:"2-digit",minute:"2-digit"}) : "";
  return `<div class="rowitem" style="padding:9px 0">
    <span class="tiny muted" style="min-width:44px" dir="ltr">${esc(tm)}</span>
    <span class="small grow">${esc(txt)}${e.name?` <span class="muted">· ${esc(e.name)}</span>`:""}</span>${pts}
  </div>`;
}
function ledgerSheet(id){
  const i = instById(id); if (!i) return;
  const rows = (i.ledger || []).slice().sort((a,b)=>(a.t||0)-(b.t||0)).map(ledgerLine).join("");
  sheet(`<h3 class="h2" style="margin-bottom:4px">${esc(t("games.ledger"))}</h3>
    <p class="small muted" style="margin-bottom:12px">${esc(i.title||i.gameId)}${i.finishedAt?` · ${esc(t("games.finished.at",{date:fmtDate(i.finishedAt)}))}`:""}</p>
    ${rows || `<p class="small muted">${esc(t("games.ledger.empty"))}</p>`}
    <button class="btn ghost block" style="margin-top:16px" data-act="closesheet">${esc(t("common.close"))}</button>`);
}
function deleteGameSheet(id){
  const i = instById(id); if (!i) return;
  sheet(`<h3 class="h2" style="color:var(--danger);margin-bottom:8px">${esc(t("games.delete.title"))}</h3>
    <p class="body" style="margin-bottom:6px"><b>${esc(i.title||i.gameId)}</b>${i.code?` · ${esc(i.code)}`:""}</p>
    <p class="small muted" style="margin-bottom:18px">${esc(t("games.delete.warn"))}</p>
    <button class="btn solid-danger block" data-act="deletegame" data-v="${esc(i.id)}">${esc(t("games.delete.go"))}</button>
    <button class="btn link" style="margin:8px auto 0;display:block" data-act="closesheet">${esc(t("common.cancel"))}</button>`);
}
async function deleteGame(id){
  const btn = document.querySelector('[data-act="deletegame"]'); if (btn){ btn.disabled = true; btn.textContent = t("common.saving"); }
  try{
    await httpsCallable(fns, "archiveInstance")({ instanceId: id });
    closeSheet(); toast(t("games.delete.done"));
    await loadEverything(); await resolveTitles(); render();
  }catch(ex){ console.warn(ex); toast(t("common.error"), "bad"); if (btn){ btn.disabled=false; btn.textContent=t("games.delete.go"); } }
}

function viewGames(){
  if (!S.instances.length)
    return pageTitle(t("games.title"), t("games.sub"))
      + emptyState("🎟️", t("games.empty.title"), t("games.empty.body"), t("games.empty.cta"), "store");

  const card = i => {
    const st  = statusOf(i);
    const cc  = custCover(i);
    const cov = cc || coverOf(i.game);
    const bits = custTitleBits(i);
    const seatsUsed = 1 + (i.invitesCount || 0);
    return `
    <article class="gamecard">
      <div class="cover" style="${cov?`background-image:url('${esc(cov)}')`:""}">
        <div class="over">
          <span class="chip ${st==="done"?"dead":st==="playing"?"warn":"lime"}">
            <span class="dot"></span>${esc(t("games.status."+st))}</span>
          <span class="row" style="gap:6px">
            ${isCustomized(i)?`<span class="chip lime">✨ ${esc(t("games.custom.badge"))}</span>`:""}
            <span class="chip ${i.role==="director"?"blue":""}">${esc(t("games.role."+i.role))}</span>
          </span>
        </div>
      </div>
      <div class="body">
        <h3 class="h2">${esc(i.title || i.gameId)}</h3>
        ${bits.length?`<p class="small lime" style="margin-top:2px">${esc(bits.join(" · "))}</p>`:""}
        <p class="small muted" style="margin:4px 0 14px">
          ${esc(t("games.seats",{used:seatsUsed,total:i.seatCount||seatsUsed}))}
          ${i.code?` · ${esc(t("games.code"))} <b class="lime">${esc(i.code)}</b>`:""}
        </p>
        <button class="btn block" data-act="play" data-v="${esc(i.id)}">
          ${esc(st==="playing"?t("games.resume"):st==="done"?t("games.replay"):t("games.start"))}
        </button>
        ${i.role==="director" ? `
        <div class="row" style="gap:8px;margin-top:8px">
          <button class="btn ghost sm grow" data-act="go" data-v="invites/${esc(i.id)}">👥 ${esc(t("dir.invite"))}</button>
          <button class="btn ghost sm grow" data-act="go" data-v="customize/${esc(i.id)}">✨ ${esc(t("dir.customize"))}</button>
          <button class="btn danger sm" data-act="deletegamesheet" data-v="${esc(i.id)}" aria-label="${esc(t("games.delete"))}">🗑</button>
        </div>` : ""}
      </div>
    </article>`;
  };
  const finishedCard = i => {
    const cov = custCover(i) || coverOf(i.game);
    const mins = i.durationMs ? Math.round(i.durationMs/60000) : null;
    return `
    <article class="gamecard">
      <div class="cover" style="aspect-ratio:21/9;${cov?`background-image:url('${esc(cov)}')`:""}">
        <div class="over"><span class="chip dead"><span class="dot"></span>${esc(t("games.status.done"))}</span>
          ${isCustomized(i)?`<span class="chip lime">✨ ${esc(t("games.custom.badge"))}</span>`:""}</div>
      </div>
      <div class="body">
        <div class="row between" style="align-items:flex-start">
          <div class="grow">
            <h3 class="h2">${esc(i.title || i.gameId)}</h3>
            <p class="small muted" style="margin-top:2px">${esc(t("games.finished.at",{date:fmtDate(i.finishedAt)}))}
              ${typeof i.finalPoints==="number"?` · <b class="lime">${esc(t("games.points",{n:i.finalPoints}))}</b>`:""}
              ${mins!=null?` · ${esc(t("games.duration",{m:mins}))}`:""}</p>
          </div>
        </div>
        <div class="row" style="gap:8px;margin-top:12px">
          <button class="btn ghost sm grow" data-act="ledger" data-v="${esc(i.id)}">📜 ${esc(t("games.ledger"))}</button>
          <button class="btn ghost sm grow" data-act="play" data-v="${esc(i.id)}">${esc(t("games.replay"))}</button>
          ${i.role==="director"?`<button class="btn danger sm" data-act="deletegamesheet" data-v="${esc(i.id)}" aria-label="${esc(t("games.delete"))}">🗑</button>`:""}
        </div>
      </div>
    </article>`;
  };
  const live = S.instances.filter(i => statusOf(i) !== "done");
  const done = S.instances.filter(i => statusOf(i) === "done");

  let out = pageTitle(t("games.title"), t("games.sub"));
  out += live.length ? `<div class="cols">${live.map(card).join("")}</div>`
                     : emptyState("🎟️", t("games.empty.title"), t("games.empty.body"), t("games.empty.cta"), "store");
  if (done.length) out += `
    <div class="page-title" style="margin-top:28px"><h2 class="h2">${esc(t("games.finished.title"))}</h2>
      <p class="small muted" style="margin-top:4px">${esc(t("games.finished.sub"))}</p></div>
    <div class="cols">${done.map(finishedCard).join("")}</div>`;
  return out;
}

function viewStore(){
  if (!S.catalog.length)
    return pageTitle(t("store.title"), t("store.sub")) + emptyState("🛒", t("store.empty"), t("games.empty.body"));

  const cards = S.catalog.map(g => {
    const cov = coverOf(g);
    return `
    <article class="gamecard">
      <div class="cover" style="${cov?`background-image:url('${esc(cov)}')`:""}">
        <div class="over"><span class="chip lime">${esc(t("store.seats.n",{n:seatOpts(g)[0]}))}+</span></div>
      </div>
      <div class="body">
        <h3 class="h2">${esc(g._title || g.id)}</h3>
        <p class="small muted" style="margin:4px 0 14px">${esc(g._blurb || "")}</p>
        <div class="row between">
          <div><span class="tiny muted">${esc(t("store.from"))}</span>
            <div class="pricetag">${freeLaunch(g)?`<s style="opacity:.45;font-size:17px">${money(priceOf(g),currencyOf(g))}</s> <span class="lime">${esc(t("store.freelaunch"))}</span>`:priceOf(g)?money(priceOf(g),currencyOf(g)):esc(t("common.free"))}</div></div>
          <button class="btn" data-act="buy" data-v="${esc(g.id)}">${esc(t("store.buy"))}</button>
        </div>
      </div>
    </article>`;
  }).join("");

  return pageTitle(t("store.title"), t("store.sub")) + `
    <div class="card" style="margin-bottom:var(--gap)">
      <h3 class="h3" style="margin-bottom:10px">${esc(t("store.what"))}</h3>
      <div class="stack" style="gap:8px">
        <div class="row"><span class="lime">✓</span><span class="small">${esc(t("store.perk.1"))}</span></div>
        <div class="row"><span class="lime">✓</span><span class="small">${esc(t("store.perk.2"))}</span></div>
        <div class="row"><span class="lime">✓</span><span class="small">${esc(t("store.perk.3"))}</span></div>
      </div>
    </div>
    <div class="cols">${cards}</div>`;
}

function viewCoupons(){
  const list = (S.profile.coupons || []);
  if (!list.length)
    return pageTitle(t("coupons.title"), t("coupons.sub"))
      + emptyState("🎁", t("coupons.empty.title"), t("coupons.empty.body"), t("games.empty.cta"), "store");

  const now = Date.now();
  const cards = list.map((c,idx) => {
    const expired = c.expiresAt && new Date(c.expiresAt).getTime() < now;
    const dead = c.used || expired;
    return `
    <div class="coupon ${dead?"used":""}">
      <div class="row between" style="align-items:flex-start;gap:14px">
        <div class="grow">
          <div class="h1" style="line-height:1.05">${esc(t("coupons.off",{pct:c.discountPct||0}))}</div>
          <p class="small" style="opacity:.75;margin:2px 0 12px">
            ${dead ? esc(c.used?t("coupons.used"):t("coupons.expired"))
                   : esc(c.expiresAt?t("coupons.expires",{date:fmtDate(c.expiresAt)}):"")}
          </p>
          <button class="code" data-act="copycoupon" data-v="${esc(c.code)}">
            ${esc(c.code)} <span style="opacity:.6;font-size:13px">⧉ ${esc(t("coupons.copy"))}</span>
          </button>
        </div>
        ${dead?"":`<button class="btn xs ghost" data-act="go" data-v="store"
            style="background:rgba(0,0,0,.16);box-shadow:none;color:#12160A">${esc(t("coupons.use"))}</button>`}
      </div>
    </div>`;
  }).join("");

  return pageTitle(t("coupons.title"), t("coupons.sub")) + `<div class="cols">${cards}</div>`;
}

function viewAccount(){
  const p = S.profile;
  const played = (p.history||[]).length;
  const done   = (p.history||[]).filter(h=>h.completed).length;
  const coup   = (p.coupons||[]).filter(c=>!c.used).length;

  return pageTitle(t("account.title"), t("account.sub")) + `
  <div class="cols-2">
    <div class="stack">
      <div class="card">
        <div class="row" style="gap:16px;margin-bottom:18px">
          <button class="avatar lg" data-act="pickavatar" title="${esc(t("account.avatar.pick"))}">${esc(p.avatar||"🎭")}</button>
          <div class="grow">
            <div class="h2 truncate">${esc(nameOf())}</div>
            <div class="small muted truncate">${esc(S.user.email||"")}</div>
            <button class="btn link" data-act="pickavatar" style="margin-top:6px">${esc(t("account.avatar.pick"))}</button>
          </div>
        </div>

        <form id="accform" class="stack">
          <label class="field"><span class="label">${esc(t("account.nickname"))}</span>
            <input class="input" name="nickname" value="${esc(p.nickname||"")}"
                   placeholder="${esc(t("account.nickname.ph"))}" maxlength="24"></label>
          <label class="field"><span class="label">${esc(t("account.fullname"))}</span>
            <input class="input" name="displayName" value="${esc(p.displayName||"")}" maxlength="60"></label>
          <label class="field"><span class="label">${esc(t("account.email"))}</span>
            <input class="input" value="${esc(S.user.email||"")}" disabled>
            <span class="hint">${esc(t("account.email.locked"))}</span></label>
          <label class="field"><span class="label">${esc(t("account.language"))}</span>
            <select class="select" name="preferredLanguage">
              ${LANGS.map(l=>`<option value="${l.code}" ${p.preferredLanguage===l.code?"selected":""}>${esc(l.label)}</option>`).join("")}
            </select></label>
          <label class="field"><span class="label">${esc(t("account.type"))}</span>
            <select class="select" name="accountType">
              <option value="personal" ${p.accountType!=="company"?"selected":""}>${esc(t("account.type.personal"))}</option>
              <option value="company"  ${p.accountType==="company"?"selected":""}>${esc(t("account.type.company"))}</option>
            </select></label>
          <label class="field ${p.accountType==="company"?"":"hide"}" id="companyfield">
            <span class="label">${esc(t("account.company"))}</span>
            <input class="input" name="companyName" value="${esc(p.companyName||"")}" maxlength="60"></label>
          <button class="btn block" type="submit">${esc(t("account.save"))}</button>
        </form>
      </div>
    </div>

    <div class="stack">
      <div class="card">
        <div class="row between" style="text-align:center">
          <div class="grow"><div class="h1">${played}</div><div class="tiny muted">${esc(t("account.stats.played"))}</div></div>
          <div class="grow"><div class="h1">${done}</div><div class="tiny muted">${esc(t("account.stats.done"))}</div></div>
          <div class="grow"><div class="h1 lime">${coup}</div><div class="tiny muted">${esc(t("account.stats.coupons"))}</div></div>
        </div>
        <div class="sep" style="margin:16px 0"></div>
        <p class="tiny muted center">${esc(t("account.member_since",{date:fmtDate(p.createdAt)}))}</p>
      </div>

      <button class="btn ghost block" data-act="signout">${esc(t("auth.signout"))}</button>

      <div class="card" style="border-color:rgba(246,76,76,.28)">
        <h3 class="h3" style="color:var(--danger);margin-bottom:8px">${esc(t("account.danger"))}</h3>
        <p class="small muted" style="margin-bottom:14px">${esc(t("account.delete.warn"))}</p>
        <button class="btn danger block" data-act="deleteaccount">${esc(t("account.delete"))}</button>
      </div>
    </div>
  </div>`;
}

/* ================================================================
   8. Views — Director
   ================================================================ */
const instById = id => S.instances.find(i => i.id === id);

async function loadInvites(inst){
  try{
    const snap = await getDocs(collection(db,"instances",inst.id,"invites"));
    inst.invites = [];
    snap.forEach(d => inst.invites.push({ token:d.id, ...d.data() }));
    inst.invites.sort((a,b)=> String(a.createdAt||"").localeCompare(String(b.createdAt||"")));
    inst.invitesCount = inst.invites.length;
  }catch(e){ console.warn("invites", e); inst.invites = inst.invites || []; }
  return inst.invites;
}

function viewDirector(){
  const mine = S.instances.filter(i => i.role === "director");
  if (!mine.length)
    return pageTitle(t("dir.title"), t("dir.sub"))
      + emptyState("🎬", t("dir.empty.title"), t("dir.empty.body"), t("games.empty.cta"), "store");

  const cards = mine.map(i => {
    const total = i.seatCount || 6;
    const used  = 1 + (i.invitesCount || (i.invites||[]).length);
    return `
    <article class="card">
      <div class="row between" style="margin-bottom:12px">
        <div class="grow">
          <h3 class="h2 truncate">${esc(i.title || i.gameId)}</h3>
          <p class="small muted">${esc(t("games.seats",{used,total}))}${i.code?` · <b class="lime">${esc(i.code)}</b>`:""}</p>
        </div>
        <span class="chip blue">${esc(t("games.role.director"))}</span>
      </div>
      <div class="seatbar" style="margin-bottom:16px">
        ${Array.from({length:total},(_,k)=>`<i class="${k<used?"on":""}"></i>`).join("")}
      </div>
      <div class="row wrap" style="gap:8px">
        <button class="btn grow sm" data-act="go" data-v="invites/${esc(i.id)}">👥 ${esc(t("dir.invite"))}</button>
        <button class="btn ghost grow sm" data-act="go" data-v="customize/${esc(i.id)}">✨ ${esc(t("dir.customize"))}</button>
        ${total < ((i.baseSeatCount||i.seatCount||total)*2) ? `<button class="btn ghost sm" data-act="addseat" data-v="${esc(i.id)}">＋ ${esc(t("dir.addseat"))}</button>` : ""}
      </div>
    </article>`;
  }).join("");

  return pageTitle(t("dir.title"), t("dir.sub")) + `<div class="cols">${cards}</div>`;
}

function viewInvites(inst){
  const total = inst.seatCount || 6;
  const list  = inst.invites || [];
  const used  = 1 + list.length;
  const left  = Math.max(0, total - used);

  const rows = `
  <div class="rowitem">
    <div class="avatar sm">${esc((S.profile&&S.profile.avatar)||"🎭")}</div>
    <div class="grow"><div class="small" style="font-weight:600">${esc(nameOf())}</div>
      <div class="tiny muted truncate">${esc(S.user.email||"")}</div></div>
    <span class="chip blue">${esc(t("inv.you"))}</span>
  </div>
  ` + (list.length ? list.map(v => `
  <div class="rowitem">
    <div class="avatar sm">${esc((v.name||"?").trim().charAt(0).toUpperCase())}</div>
    <div class="grow"><div class="small truncate" style="font-weight:600">${esc(v.name||"")}</div>
      <div class="tiny muted truncate">${esc(v.email||"")}</div></div>
    <span class="chip ${v.status==="accepted"?"lime":""}">${esc(v.status==="accepted"?t("inv.accepted"):t("inv.pending"))}</span>
    <button class="iconbtn" data-act="shareinvite" data-v="${esc(inst.id)}|${esc(v.token)}" aria-label="${esc(t("inv.share"))}">↗</button>
    <button class="iconbtn" data-act="delinvite" data-v="${esc(inst.id)}|${esc(v.token)}" aria-label="${esc(t("inv.remove"))}">✕</button>
  </div>`).join("") : `<p class="small muted" style="padding:16px 0">${esc(t("inv.none"))}</p>`);

  return pageTitle(t("inv.title"), left ? t("inv.sub",{left,total}) : t("inv.full",{total}), "director") + `
  <div class="cols-2">
    <div class="card">
      <div class="row between" style="margin-bottom:8px">
        <h3 class="h3">${esc(inst.title || inst.gameId)}</h3>
        <span class="chip" dir="ltr">${used} / ${total}</span>
      </div>
      <div class="seatbar" style="margin-bottom:6px">
        ${Array.from({length:total},(_,k)=>`<i class="${k<used?"on":""}"></i>`).join("")}
      </div>
      ${rows}
    </div>

    <div class="card">
      <form id="invform" class="stack">
        <label class="field"><span class="label">${esc(t("inv.name"))}</span>
          <input class="input" name="name" placeholder="${esc(t("inv.name.ph"))}" required maxlength="40"></label>
        <label class="field"><span class="label">${esc(t("inv.email"))}</span>
          <input class="input" name="email" type="email" inputmode="email"
                 placeholder="${esc(t("auth.email.ph"))}" required></label>
        <p class="hint err hide" id="inverr"></p>
        <button class="btn block" type="submit" ${left?"":"disabled"}>${esc(t("inv.add"))}</button>
      </form>
    </div>
  </div>`;
}

function viewCustomize(inst){
  const manifest = (inst.game && inst.game.customizable) || [];
  const locked   = !!(inst.playedAt || inst.status === "played" || inst.status === "finished");
  const values   = inst.customization || {};

  if (!manifest.length)
    return pageTitle(t("cust.title"), t("cust.sub"), "director")
      + emptyState("✨", t("cust.none"), t("dir.sub"));

  const fields = manifest.map(f => {
    const v   = values[f.key] ?? "";
    const lab = f.label || f.key.replace(/_/g," ");
    const id  = "cf_" + f.key;
    if (f.type === "image" || f.type === "video"){
      const has = !!v;
      return `
      <div class="field" data-cust="${esc(f.key)}" data-type="${esc(f.type)}">
        <span class="label">${esc(lab)}</span>
        ${has ? (f.type==="image"
            ? `<img class="thumb" src="${esc(v)}" alt="">`
            : `<video class="thumb" src="${esc(v)}" controls playsinline></video>`)
          : `<div class="drop" data-act="pickfile" data-v="${esc(f.key)}">
               <div style="font-size:26px;margin-bottom:6px">${f.type==="image"?"🖼️":"🎬"}</div>
               <div class="small">${esc(f.type==="image"?t("cust.drop"):t("cust.drop.video"))}</div>
               <div class="tiny muted" style="margin-top:4px">${esc(t("cust.default"))}</div>
             </div>`}
        <input type="file" class="hide" id="file_${esc(f.key)}"
               accept="${esc((f.accept||[]).join(",") || (f.type==="image"?"image/*":"video/*"))}">
        <div class="row" style="gap:8px;margin-top:8px">
          <button type="button" class="btn ghost xs" data-act="pickfile" data-v="${esc(f.key)}">
            ${esc(has?t("cust.replace"):t("cust.upload"))}</button>
          ${has?`<button type="button" class="btn ghost xs" data-act="clearfile" data-v="${esc(f.key)}">${esc(t("cust.remove"))}</button>`:""}
          <span class="tiny muted grow" id="prog_${esc(f.key)}"></span>
        </div>
        <input class="input" style="margin-top:8px" name="${esc(f.key)}" value="${esc(v)}"
               placeholder="${esc(t("cust.or_url"))}" id="${id}">
      </div>`;
    }
    if (f.type === "textarea" || (f.maxLength && f.maxLength > 80)){
      return `<label class="field"><span class="label">${esc(lab)}</span>
        <textarea class="textarea" name="${esc(f.key)}" maxlength="${f.maxLength||400}"
          placeholder="${esc(f._def||f.default||"")}">${esc(v)}</textarea></label>`;
    }
    return `<label class="field"><span class="label">${esc(lab)}</span>
      <input class="input" name="${esc(f.key)}" maxlength="${f.maxLength||60}"
             value="${esc(v)}" placeholder="${esc(f._def||f.default||"")}"></label>`;
  }).join("");

  return pageTitle(t("cust.title"), t("cust.sub"), "director") + `
  ${locked?`<div class="card" style="border-color:rgba(255,173,13,.35);margin-bottom:var(--gap)">
      <div class="row"><span>⚠️</span><span class="small">${esc(t("cust.locked"))}</span></div></div>`:""}
  <div class="card">
    <h3 class="h3" style="margin-bottom:16px">${esc(inst.title || inst.gameId)}</h3>
    <form id="custform" class="stack" ${locked?"inert":""} style="${locked?"opacity:.55;pointer-events:none":""}">
      ${fields}
      <button class="btn block" type="submit">${esc(t("cust.save"))}</button>
    </form>
  </div>`;
}

function viewJoin(instanceId, token, invite, inst){
  if (!invite) return pageTitle(t("join.title")) + emptyState("🔒", t("join.bad"), t("games.empty.body"), t("games.empty.cta"), "games");
  return pageTitle(t("join.title")) + `
  <div class="card center" style="padding:30px 22px">
    <div style="font-size:44px;margin-bottom:12px">🎟️</div>
    <h2 class="h1" style="margin-bottom:8px">${esc(invite.name||"")}</h2>
    <p class="body muted" style="margin-bottom:22px">
      ${esc(t("join.body",{ director: invite.fromName || "Your Director", game: (inst && inst.title) || "" }))}</p>
    <button class="btn block" data-act="acceptinvite" data-v="${esc(instanceId)}|${esc(token)}">${esc(t("join.cta"))}</button>
  </div>`;
}

/* ================================================================
   9. Render
   ================================================================ */
async function render(){
  if (!S.user){ renderAuth(); return; }
  document.body.classList.remove("auth-mode");

  const { name, args } = S.route;
  let body = "";

  if (name === "join"){
    const [instanceId, token] = args;
    let invite = null, inst = null;
    try{
      const d = await getDoc(doc(db,"instances",instanceId,"invites",token));
      if (d.exists()) invite = d.data();
      const i = await getDoc(doc(db,"instances",instanceId));
      if (i.exists()){
        inst = { id:instanceId, ...i.data() };
        inst.game  = await loadGame(inst.gameId);
        inst.title = await gt(inst.game, inst.game.title_key, inst.game.title || inst.gameId);
      }
    }catch(e){ console.warn("join", e); }
    body = viewJoin(instanceId, token, invite, inst);
  }
  else if (name === "invites" || name === "customize"){
    const inst = instById(args[0]);
    if (!inst) { go("director"); return; }
    if (name === "invites"){
      await loadInvites(inst);
      body = viewInvites(inst);
    } else {
      const man = (inst.game && inst.game.customizable) || [];
      await Promise.all(man.map(async f => {
        f.label = await gt(inst.game, f.label_key, f.label || f.key.replace(/_/g," "));
        f._def = f.default_key ? await gt(inst.game, f.default_key, f.default || "") : (f.default || "");
      }));
      body = viewCustomize(inst);
    }
  }
  else if (name === "store")    body = viewStore();
  else if (name === "coupons")  body = viewCoupons();
  else if (name === "account")  body = viewAccount();
  else if (name === "director") body = viewDirector();
  else                          body = viewGames();

  root.innerHTML = shell(body);
  wire();
}

/* ================================================================
   10. Interactions — one delegated listener, actions named in data-act
   ================================================================ */
function wire(){
  const form = $("#accform");
  if (form){
    form.addEventListener("submit", saveAccount);
    const sel = form.querySelector("[name=accountType]");
    sel && sel.addEventListener("change", e => {
      $("#companyfield").classList.toggle("hide", e.target.value !== "company");
    });
  }
  const inv = $("#invform");
  inv && inv.addEventListener("submit", createInvite);
  const cf = $("#custform");
  cf && cf.addEventListener("submit", saveCustomization);

  document.querySelectorAll('[data-cust] input[type=file]').forEach(i =>
    i.addEventListener("change", onFileChosen));
}

document.addEventListener("click", async e => {
  const btn = e.target.closest("[data-act]");
  if (!btn) return;
  const act = btn.dataset.act, v = btn.dataset.v || "";

  switch(act){
    case "mode":       authMode = v; renderAuth(); break;
    case "go":         go(v); break;
    case "langpick":   langSheet(); break;
    case "setlang":    closeSheet(); setLang(v); if (S.user) saveLangPref(v); break;
    case "forgot":     await forgot(); break;
    case "signout":    await signOut(auth); break;
    case "pickavatar": avatarSheet(); break;
    case "setavatar":  await setAvatar(v); break;
    case "play":       playInstance(v); break;
    case "buy":        buySheet(v); break;
    case "copycoupon": await copy(v); toast(t("coupons.copied")); break;
    case "shareinvite":{ const [id,tok]=v.split("|"); shareSheet(id,tok); break; }
    case "delinvite":  { const [id,tok]=v.split("|"); await removeInvite(id,tok); break; }
    case "acceptinvite":{ const [id,tok]=v.split("|"); await acceptInvite(id,tok); break; }
    case "addseat":{
      try{
        const r = await httpsCallable(fns, "addSeat")({ instanceId: v });
        toast(t("dir.addseat.done", { n: r.data.seatCount }));
        await loadEverything(); await resolveTitles(); render();
      }catch(ex){ console.warn(ex); toast(t("dir.addseat.max"), "bad"); }
      break; }
    case "deleteaccount": deleteSheet(); break;
    case "deletegamesheet": deleteGameSheet(v); break;
    case "deletegame":  await deleteGame(v); break;
    case "ledger":      ledgerSheet(v); break;
    case "closesheet": closeSheet(); break;
    case "pickfile":   { const el = $("#file_"+v); el && el.click(); break; }
    case "clearfile":  { const el = $("#cf_"+v); if (el) el.value=""; render(); break; }
    case "copytext":   await copy(v); toast(t("common.copied")); break;
  }
});

/* ---- language ---- */
function langSheet(){
  sheet(`<h3 class="h2" style="margin-bottom:14px">🌐 ${esc(t("account.language"))}</h3>
    <div class="stack">
      ${LANGS.map(l=>`<button class="btn ${l.code===S.lang?"":"ghost"} block" data-act="setlang" data-v="${l.code}">${esc(l.label)}</button>`).join("")}
      <button class="btn link" style="margin:6px auto 0" data-act="closesheet">${esc(t("common.close"))}</button>
    </div>`);
}
async function saveLangPref(code){
  try{ await updateDoc(doc(db,"users",S.user.uid), { preferredLanguage: code });
       S.profile.preferredLanguage = code; }catch{}
}

async function forgot(){
  const email = (document.querySelector("[name=email]")||{}).value;
  if (!email) return toast(t("auth.reset.need_email"), "bad");
  try{ await sendPasswordResetEmail(auth, email.trim()); toast(t("auth.reset.sent")); }
  catch{ toast(t("common.error"), "bad"); }
}

/* ---- avatar ---- */
function avatarSheet(){
  sheet(`<h3 class="h2" style="margin-bottom:14px">${esc(t("account.avatar.pick"))}</h3>
    <div class="avgrid">
      ${AVATARS.map(a=>`<button class="${a===S.profile.avatar?"on":""}" data-act="setavatar" data-v="${a}">${a}</button>`).join("")}
    </div>
    <button class="btn ghost block" style="margin-top:16px" data-act="closesheet">${esc(t("common.close"))}</button>`);
}
async function setAvatar(a){
  S.profile.avatar = a;
  closeSheet(); render();
  try{ await updateDoc(doc(db,"users",S.user.uid), { avatar:a }); }catch{ toast(t("common.error"),"bad"); }
}

/* ---- account ---- */
async function saveAccount(e){
  e.preventDefault();
  const btn = e.target.querySelector("button[type=submit]");
  btn.disabled = true; btn.textContent = t("common.saving");
  const f = new FormData(e.target);
  const patch = {
    nickname:   String(f.get("nickname")||"").trim(),
    displayName:String(f.get("displayName")||"").trim(),
    preferredLanguage: String(f.get("preferredLanguage")||S.lang),
    accountType:String(f.get("accountType")||"personal"),
    companyName:String(f.get("companyName")||"").trim() || null
  };
  try{
    await updateDoc(doc(db,"users",S.user.uid), patch);
    if (patch.displayName) await updateProfile(S.user, { displayName: patch.displayName });
    Object.assign(S.profile, patch);
    toast(t("account.saved"));
    if (patch.preferredLanguage !== S.lang) setLang(patch.preferredLanguage); else render();
  }catch(ex){ console.warn(ex); toast(t("common.error"),"bad");
    btn.disabled=false; btn.textContent=t("account.save"); }
}

function deleteSheet(){
  sheet(`<h3 class="h2" style="color:var(--danger);margin-bottom:8px">${esc(t("account.delete"))}</h3>
    <p class="small muted" style="margin-bottom:16px">${esc(t("account.delete.warn"))}</p>
    <form id="delform" class="stack">
      <label class="field"><span class="label">${esc(t("account.delete.pw"))}</span>
        <input class="input" name="pw" type="password" autocomplete="current-password"></label>
      <label class="field"><span class="label">${esc(t("account.delete.confirm"))}</span>
        <input class="input" name="confirm" placeholder="DELETE" autocapitalize="characters"></label>
      <p class="hint err hide" id="delerr"></p>
      <button class="btn solid-danger block" type="submit">${esc(t("account.delete.go"))}</button>
      <button class="btn link" type="button" style="margin:4px auto 0" data-act="closesheet">${esc(t("common.cancel"))}</button>
    </form>`, scrim => {
      scrim.querySelector("#delform").addEventListener("submit", doDelete);
    });
}
async function doDelete(e){
  e.preventDefault();
  const f = new FormData(e.target), err = $("#delerr");
  const btn = e.target.querySelector("button[type=submit]");
  if (String(f.get("confirm")||"").trim().toUpperCase() !== "DELETE"){
    err.textContent = t("account.delete.confirm"); err.classList.remove("hide"); return;
  }
  btn.disabled = true;
  try{
    const pw = String(f.get("pw")||"");
    if (pw) await reauthenticateWithCredential(S.user, EmailAuthProvider.credential(S.user.email, pw));
    try{ await deleteDoc(doc(db,"users",S.user.uid)); }catch{}
    await deleteUser(S.user);
    closeSheet(); toast(t("account.delete.done"));
  }catch(ex){
    err.textContent = (ex.code||"").includes("requires-recent-login")
      ? t("account.delete.needpw") : t("common.error");
    err.classList.remove("hide"); btn.disabled = false;
  }
}

/* ---- play ---- */
function playInstance(id){
  const i = instById(id);
  if (!i) return;
  const q = i.code ? `?code=${encodeURIComponent(i.code)}` : `?instance=${encodeURIComponent(id)}`;
  const gq = i.gameId ? `&game=${encodeURIComponent(i.gameId)}` : "";
  location.href = "game.html" + q + gq + `&lang=${encodeURIComponent(i.language || S.lang)}`;
}

/* ---- store ---- */
function buySheet(gameId){
  const g = S.catalog.find(x=>x.id===gameId) || S.gamesById[gameId] || { id:gameId };
  const opts = seatOpts(g);
  const cur  = currencyOf(g);
  const base = priceOf(g);
  const usable = (S.profile.coupons||[]).filter(c=>!c.used &&
      (!c.expiresAt || new Date(c.expiresAt).getTime() > Date.now()));

  sheet(`
    <h3 class="h2" style="margin-bottom:4px">${esc(g._title || g.title || g.id)}</h3>
    <p class="small muted" style="margin-bottom:18px">${esc(g._blurb || "")}</p>
    <form id="buyform" class="stack">
      <div class="field"><span class="label">${esc(t("store.seats"))}</span>
        <div class="seatpick" id="seatpick">
          ${opts.map((n,ix)=>`<div class="opt ${ix===0?"on":""}" data-seats="${n}">${n}
             <small>${esc(t("store.seats.n",{n}))}</small></div>`).join("")}
        </div>
      </div>
      ${freeLaunch(g)?`
      <label class="field"><span class="label">${esc(t("store.claim"))}</span>
        <input class="input" name="claimcode" placeholder="${esc(t("store.claim.ph"))}" autocapitalize="none" autocomplete="off"></label>`:""}
      ${usable.length?`
      <label class="field"><span class="label">${esc(t("store.coupon"))}</span>
        <select class="select" name="coupon">
          <option value="">—</option>
          ${usable.map(c=>`<option value="${esc(c.code)}" data-pct="${c.discountPct||0}">${esc(c.code)} · ${esc(t("coupons.off",{pct:c.discountPct||0}))}</option>`).join("")}
        </select></label>`:""}
      <div class="sep"></div>
      <div class="row between">
        <span class="h3">${esc(t("store.total"))}</span>
        <span class="pricetag lime" id="buytotal">${base?money(base,cur):esc(t("common.free"))}</span>
      </div>
      <button class="btn block" type="submit">${esc(t("store.checkout"))}</button>
      <button class="btn link" type="button" style="margin:2px auto 0" data-act="closesheet">${esc(t("common.cancel"))}</button>
    </form>`, scrim => {
      const pick = scrim.querySelector("#seatpick");
      const total= scrim.querySelector("#buytotal");
      const sel  = scrim.querySelector("[name=coupon]");
      const recalc = () => {
        const seats = Number(pick.querySelector(".opt.on").dataset.seats);
        const perSeat = (g.store && g.store.perSeat) || 0;
        const pct = sel && sel.selectedOptions[0] ? Number(sel.selectedOptions[0].dataset.pct||0) : 0;
        let cents = base + perSeat * seats;
        cents = Math.round(cents * (1 - pct/100));
        if (freeLaunch(g)) cents = 0;
        total.textContent = cents ? money(cents, cur) : t("common.free");
        return { seats, pct, cents };
      };
      pick.addEventListener("click", ev => {
        const o = ev.target.closest(".opt"); if (!o) return;
        pick.querySelectorAll(".opt").forEach(x=>x.classList.remove("on"));
        o.classList.add("on"); recalc();
      });
      sel && sel.addEventListener("change", recalc);
      scrim.querySelector("#buyform").addEventListener("submit", async ev => {
        ev.preventDefault();
        const { seats, cents } = recalc();
        const payload = { gameId:g.id, seatCount:seats, amount:cents, currency:cur,
                          language:S.lang, coupon: sel ? sel.value : "" };
        const b = ev.target.querySelector("button[type=submit]");
        b.disabled = true; b.textContent = t("common.saving");
        try{
          if (freeLaunch(g)){
            const codeInEl = document.querySelector('input[name="claimcode"]'); const codeIn = String((codeInEl&&codeInEl.value)||"").trim();
            const claim = httpsCallable(fns, "claimGame");
            await claim({ gameId:g.id, seatCount:seats, language:S.lang, claimCode:codeIn });
            closeSheet();
            await loadEverything(); await resolveTitles();
            toast(t("store.claimed"));
            go("games"); render();
            return;
          }
          const call = httpsCallable(fns, "createCheckoutSession");
          const res  = await call(payload);
          if (res && res.data && res.data.url){ location.href = res.data.url; return; }
          throw new Error("no url");
        }catch(ex){
          console.warn("claim failed / checkout not available", ex);
          if (freeLaunch(g)){
            b.disabled = false; b.textContent = t("store.checkout");
            toast(t("store.claim.bad"), "bad");
            return;
          }
          closeSheet();
          toast(t("store.checkout.soon"));
        }
      });
    });
}

/* ---- invites ---- */
const token16 = () => {
  const a = new Uint8Array(12); crypto.getRandomValues(a);
  return [...a].map(b=>b.toString(36).padStart(2,"0")).join("").slice(0,18);
};
const inviteLink = (instanceId, tok) =>
  `${location.origin}${location.pathname}#/join/${instanceId}/${tok}`;

async function createInvite(e){
  e.preventDefault();
  const inst = instById(S.route.args[0]);
  const f = new FormData(e.target), err = $("#inverr");
  const name = String(f.get("name")||"").trim();
  const email= String(f.get("email")||"").trim().toLowerCase();
  err.classList.add("hide");
  if (!/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(email)){
    err.textContent = t("inv.err.email"); err.classList.remove("hide"); return;
  }
  if ((inst.invites||[]).some(v => (v.email||"").toLowerCase() === email)){
    err.textContent = t("inv.err.dupe"); err.classList.remove("hide"); return;
  }
  const btn = e.target.querySelector("button[type=submit]");
  btn.disabled = true;
  const tok = token16();
  try{
    await setDoc(doc(db,"instances",inst.id,"invites",tok), {
      name, email, status:"pending",
      fromUid:S.user.uid, fromName:nameOf(),
      createdAt:new Date().toISOString()
    });
    await loadInvites(inst);
    toast(t("inv.created"));
    await render();
    shareSheet(inst.id, tok);
  }catch(ex){
    console.warn(ex); err.textContent = t("common.error"); err.classList.remove("hide"); btn.disabled=false;
  }
}

async function removeInvite(instanceId, tok){
  const inst = instById(instanceId);
  const v = (inst.invites||[]).find(x=>x.token===tok);
  if (!confirm(t("inv.remove.confirm",{name:(v&&v.name)||""}))) return;
  try{
    await deleteDoc(doc(db,"instances",instanceId,"invites",tok));
    await loadInvites(inst); render();
  }catch{ toast(t("common.error"),"bad"); }
}

function shareSheet(instanceId, tok){
  const inst = instById(instanceId) || {};
  const v = (inst.invites||[]).find(x=>x.token===tok) || {};
  const link = inviteLink(instanceId, tok);
  const msg  = t("inv.share.msg", { name:v.name||"", game:inst.title||"", link });
  const enc  = encodeURIComponent(msg);

  sheet(`
    <h3 class="h2 center" style="margin-bottom:18px">${esc(t("inv.share.title"))}</h3>
    <div class="sharegrid">
      <button data-href="https://wa.me/?text=${enc}"><div class="bub">💬</div>${esc(t("common.whatsapp"))}</button>
      <button data-href="mailto:${encodeURIComponent(v.email||"")}?subject=${encodeURIComponent(inst.title||"TotemTime")}&body=${enc}"><div class="bub">✉️</div>${esc(t("common.email"))}</button>
      <button data-href="https://t.me/share/url?url=${encodeURIComponent(link)}&text=${enc}"><div class="bub">✈️</div>${esc(t("common.telegram"))}</button>
      <button data-native><div class="bub">⋯</div>${esc(t("common.more"))}</button>
    </div>
    <p class="tiny muted center" style="margin:20px 0 10px">${esc(t("inv.share.with"))}</p>
    <div class="row" style="gap:8px">
      <input class="input grow" readonly value="${esc(link)}" onclick="this.select()">
      <button class="iconbtn" data-act="copytext" data-v="${esc(link)}" aria-label="${esc(t("common.copy"))}">⧉</button>
    </div>
    <button class="btn ghost block" style="margin-top:16px" data-act="closesheet">${esc(t("common.close"))}</button>
  `, scrim => {
    scrim.querySelectorAll("[data-href]").forEach(b =>
      b.addEventListener("click", () => window.open(b.dataset.href, "_blank", "noopener")));
    const nat = scrim.querySelector("[data-native]");
    nat && nat.addEventListener("click", async () => {
      if (navigator.share) { try{ await navigator.share({ title:inst.title||"TotemTime", text:msg, url:link }); }catch{} }
      else { await copy(link); toast(t("common.copied")); }
    });
  });
}

async function acceptInvite(instanceId, tok){
  try{
    await updateDoc(doc(db,"instances",instanceId,"invites",tok), {
      status:"accepted", uid:S.user.uid, acceptedAt:new Date().toISOString()
    });
    await updateDoc(doc(db,"users",S.user.uid), { instances: arrayUnion(instanceId) });
    S.profile.instances = [...new Set([...(S.profile.instances||[]), instanceId])];
    await loadEverything(); await resolveTitles();
    toast(t("join.done"));
    go("games");
  }catch(ex){ console.warn(ex); toast(t("common.error"), "bad"); }
}

/* ---- customization ---- */
async function onFileChosen(e){
  const wrap = e.target.closest("[data-cust]");
  const key  = wrap.dataset.cust;
  const inst = instById(S.route.args[0]);
  const file = e.target.files[0];
  if (!file || !inst) return;
  const man  = ((inst.game && inst.game.customizable) || []).find(f=>f.key===key) || {};
  const max  = man.maxBytes || (wrap.dataset.type === "video" ? 60e6 : 5e6);
  const prog = $("#prog_"+key);
  if (file.size > max){ toast(t("cust.toobig",{mb:Math.round(max/1e6)}), "bad"); return; }
  prog.textContent = t("cust.uploading");
  try{
    const ext = (file.name.split(".").pop()||"bin").toLowerCase().replace(/[^a-z0-9]/g,"");
    const r   = sRef(store, `instances/${inst.id}/${key}.${ext}`);
    await uploadBytes(r, file, { contentType: file.type });
    const url = await getDownloadURL(r);
    const input = $("#cf_"+key);
    if (input) input.value = url;
    inst.customization = { ...(inst.customization||{}), [key]: url };
    prog.textContent = "";
    // no full render: would wipe unsaved text fields. Update just this field's preview.
    const prev = document.querySelector('[data-cust="'+key+'"] img.custprev');
    if (prev) prev.src = url;
  }catch(ex){ console.warn(ex); prog.textContent = ""; toast(t("common.error"), "bad"); }
}

async function saveCustomization(e){
  e.preventDefault();
  const inst = instById(S.route.args[0]);
  const btn = e.target.querySelector("button[type=submit]");
  btn.disabled = true; btn.textContent = t("common.saving");
  const out = {};
  new FormData(e.target).forEach((val,k)=>{ out[k] = String(val); });
  try{
    await updateDoc(doc(db,"instances",inst.id), { customization: out });
    inst.customization = out;
    toast(t("cust.saved"));
    btn.disabled = false; btn.textContent = t("cust.save");
  }catch(ex){
    console.warn(ex); toast(t("common.error"), "bad");
    btn.disabled = false; btn.textContent = t("cust.save");
  }
}

/* ================================================================
   11. Boot
   ================================================================ */
setLangSilent(S.lang);
function setLangSilent(code){
  const meta = LANGS.find(l=>l.code===code) || LANGS[0];
  document.documentElement.lang = code;
  document.documentElement.dir  = meta.dir;
}

S.route = parseHash();
root.innerHTML = `<div class="authwrap"><div class="card sk" style="height:220px"></div></div>`;

onAuthStateChanged(auth, async user => {
  S.user = user;
  if (!user){ S.profile=null; S.instances=[]; renderAuth(); return; }
  try{
    await loadEverything();
    await resolveTitles();
    // pre-count invites so seat meters are right on the first paint
    await Promise.all(S.instances.filter(i=>i.role==="director").map(loadInvites));
  }catch(e){ console.warn("boot", e); }
  render();
});
</script>
</body>
</html>