<!DOCTYPE html>
<html lang="he" dir="rtl">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1"/>
<title>TotemTime</title>
<link rel="icon" href="/assets/brand/favicon.ico">
<link rel="icon" type="image/png" sizes="32x32" href="/assets/brand/favicon-32.png">
<link rel="apple-touch-icon" href="/assets/brand/apple-touch-icon.png">
<link rel="icon" type="image/png" href="/assets/games/kidnapped-il/logo.png"/>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/pannellum@2.5.6/build/pannellum.css"/>
<script src="https://cdn.jsdelivr.net/npm/pannellum@2.5.6/build/pannellum.js"></script>
<style>
:root{--tt-bg:#0c0c0e;--tt-sheet:#18181b;--tt-text:#f6f6f4;--tt-muted:#8c8c93;--tt-accent:#c8ee5b;--tt-accent-ink:#14160c;--tt-border:rgba(255,255,255,.08);--tt-uv:#8b5cf6;color-scheme:dark;}
*{box-sizing:border-box;}
body{margin:0;background:#050506;color:var(--tt-text);font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Helvetica,Arial,sans-serif;-webkit-font-smoothing:antialiased;}
.dev{position:sticky;top:0;z-index:50;display:flex;flex-wrap:wrap;gap:.4rem;align-items:center;justify-content:center;padding:.5rem;background:#111318;border-bottom:1px solid var(--tt-border);}
.dev .g{display:flex;gap:.2rem;align-items:center;background:#1a1d24;border:1px solid #2a2e38;border-radius:.5rem;padding:.25rem;}
.dev .g>span{font-size:.65rem;color:#6b7280;padding:0 .3rem;}
.dev button{background:#232733;color:#e8e8ea;border:1px solid #333846;border-radius:.4rem;padding:.3rem .6rem;font-size:.8rem;cursor:pointer;}
.dev button.on{background:var(--tt-accent);border-color:var(--tt-accent);color:var(--tt-accent-ink);font-weight:700;}
.wrap{display:flex;justify-content:center;padding:1rem;}
.phone{position:relative;width:100%;max-width:380px;min-height:660px;display:flex;flex-direction:column;background:var(--tt-bg);border-radius:26px;border:1px solid var(--tt-border);overflow:hidden;transition:background .6s;}
.phone.uv{background:#120e24;border-color:rgba(139,92,246,.4);}
.topbar{display:flex;align-items:center;justify-content:space-between;gap:8px;padding:14px 16px;border-bottom:1px solid var(--tt-border);}
.brandside{display:flex;align-items:center;gap:8px;min-width:0;}
.logo{width:28px;height:28px;border-radius:7px;background:radial-gradient(circle at 50% 32%,var(--tt-accent),#6f9a2a);flex:0 0 auto;}
.pl{display:flex;flex-direction:column;gap:2px;min-width:0;}
.pl .nm{font-size:14px;font-weight:700;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
.badge{font-size:10px;font-weight:700;color:var(--tt-accent);background:rgba(200,238,91,.14);padding:2px 8px;border-radius:999px;width:fit-content;}
.timer{font-variant-numeric:tabular-nums;font-size:15px;font-weight:700;letter-spacing:1px;}
.rightside{display:flex;align-items:center;gap:10px;}
.metaside{display:flex;flex-direction:column;align-items:flex-end;gap:3px;}
.pts{font-size:11px;font-weight:800;color:var(--tt-accent-ink);background:var(--tt-accent);padding:2px 8px;border-radius:999px;}
.stg{font-size:10px;font-weight:700;color:var(--tt-muted);text-transform:uppercase;}
.body{flex:1;display:flex;flex-direction:column;padding:26px 22px;gap:18px;overflow-y:auto;}
.c-title{margin:0;font-size:28px;font-weight:800;letter-spacing:-.3px;line-height:1.15;}
.c-sub{margin:0;font-size:15px;color:var(--tt-muted);line-height:1.5;}
.c-text{margin:0;font-size:16px;color:#cfcfd4;line-height:1.55;white-space:pre-line;}
.c-img{width:100%;max-height:340px;object-fit:contain;border-radius:14px;border:1px solid var(--tt-border);display:block;background:#fff;cursor:zoom-in;}
.c-vid{width:100%;max-height:340px;border-radius:14px;border:1px solid var(--tt-border);background:#000;display:block;}
.c-vid.pv{cursor:pointer;}.c-aud{width:100%;margin:4px 0;}.c-pano{width:100%;height:300px;border-radius:14px;overflow:hidden;border:1px solid var(--tt-border);background:#000;}
.warn{margin:0;padding:12px 14px;font-size:14px;font-weight:600;line-height:1.45;background:rgba(200,238,91,.08);border:1px solid rgba(200,238,91,.25);border-radius:14px;}
.cta{width:100%;min-height:56px;border:none;border-radius:16px;background:var(--tt-accent);color:var(--tt-accent-ink);font-size:18px;font-weight:800;cursor:pointer;margin-top:auto;box-shadow:0 12px 30px rgba(200,238,91,.2);}
.cta:active{transform:translateY(2px);}
.cta[disabled]{opacity:.85;}
.hints{display:flex;gap:10px;}.chip:disabled{opacity:.4;}
.chip{flex:1;min-height:44px;border-radius:12px;cursor:pointer;background:rgba(255,255,255,.05);border:1px solid var(--tt-border);color:var(--tt-text);font-size:14px;font-weight:700;}
.input{width:100%;min-height:54px;padding:0 16px;border-radius:14px;border:1px solid var(--tt-border);background:rgba(255,255,255,.04);color:var(--tt-text);font-size:18px;font-weight:600;outline:none;}
.input:focus{border-color:var(--tt-accent);}
.scrim{position:absolute;inset:0;z-index:30;display:flex;align-items:flex-end;justify-content:center;background:rgba(4,4,6,.55);}
.sheet{position:relative;width:100%;background:var(--tt-sheet);border-top-left-radius:26px;border-top-right-radius:26px;padding:46px 24px 34px;text-align:center;animation:rise .4s cubic-bezier(.22,1,.36,1);}
.sheet.hb{text-align:start;max-height:70%;overflow-y:auto;padding-top:26px;}
.peak{position:absolute;top:-17px;left:50%;transform:translateX(-50%);width:0;height:0;border-left:26px solid transparent;border-right:26px solid transparent;border-bottom:18px solid var(--tt-sheet);}
@keyframes rise{from{transform:translateY(50px);opacity:0;}to{transform:translateY(0);opacity:1;}}
.glyph{font-size:44px;}
.p-title{margin:.4rem 0 .5rem;font-size:28px;font-weight:800;}
.p-title.win{color:var(--tt-accent);}
.p-body{margin:0 0 22px;font-size:15px;color:var(--tt-muted);line-height:1.5;white-space:pre-line;}
.cd{display:flex;flex-direction:column;align-items:center;gap:20px;margin:auto;}
.cd .lbl{font-size:13px;font-weight:600;letter-spacing:1.5px;text-transform:uppercase;color:var(--tt-muted);}
.ring{width:180px;height:180px;border-radius:50%;border:2px solid rgba(255,255,255,.1);display:flex;align-items:center;justify-content:center;}
.num{font-size:100px;font-weight:800;animation:pop 1s ease-out;}
@keyframes pop{0%{transform:scale(.5);opacity:0;}30%{transform:scale(1.15);opacity:1;}100%{transform:scale(1);}}
.grid{display:flex;gap:12px;padding:16px;overflow-x:auto;}
.col{flex:0 0 250px;background:var(--tt-bg);border:1px solid var(--tt-border);border-radius:16px;overflow:hidden;display:flex;flex-direction:column;}
.col h4{margin:0;padding:10px 12px;font-size:13px;background:#141519;border-bottom:1px solid var(--tt-border);color:var(--tt-accent);}
.col .cbody{padding:14px;display:flex;flex-direction:column;gap:12px;}
.col .cta,.col .chip,.col .input{pointer-events:none;}
.hidden-note{color:#5b616b;font-size:.75rem;border:1px dashed #333846;border-radius:8px;padding:6px 8px;}
.adminbar{display:flex;justify-content:center;align-items:center;gap:10px;padding:12px;font-size:.9rem;color:var(--tt-muted);}
.lb{position:fixed;inset:0;z-index:100;background:rgba(0,0,0,.92);display:none;align-items:center;justify-content:center;padding:20px;cursor:zoom-out;}
.lb.open{display:flex;}
.lb img{max-width:96vw;max-height:96vh;object-fit:contain;border-radius:8px;background:#fff;}
/* ---- widgets ---- */
.wdg{background:#131318;border:1px solid var(--tt-border);border-radius:16px;padding:14px;text-align:center;}
.wdg.done{border-color:rgba(200,238,91,.35);}
.wdg.locked{opacity:.5;}
.wdg .wname{font-size:12px;font-weight:800;letter-spacing:.06em;color:var(--tt-accent);text-transform:uppercase;margin:0 0 8px;}
.wdg .wcap{font-size:12.5px;color:var(--tt-muted);margin:10px 0 0;}
.wdg .readout{font-size:40px;font-weight:800;font-variant-numeric:tabular-nums;letter-spacing:1px;background:#0a0a0c;border:1px solid var(--tt-border);border-radius:12px;padding:8px 0;margin:6px 0 10px;}
.wdg .readout.done{color:var(--tt-accent);border-color:rgba(200,238,91,.4);}
.wdg .row{display:flex;gap:8px;justify-content:center;}
.wdg .row .cta{flex:1;min-height:44px;margin:0;box-shadow:none;font-size:15px;}
.pips{display:flex;gap:6px;justify-content:center;margin:8px 0;}
.pip{width:10px;height:10px;border-radius:50%;background:#26262e;border:1px solid var(--tt-border);}
.pip.on{background:var(--tt-accent);border-color:var(--tt-accent);}
.ttrack{position:relative;width:220px;height:220px;margin:6px auto;border-radius:50%;border:3px dashed #3a3a44;}
.tchar{position:absolute;width:30px;height:30px;line-height:30px;font-weight:800;font-size:17px;color:#cfcfd4;transform:translate(-50%,-50%);}
.tchar.hot{color:var(--tt-accent);text-shadow:0 0 12px rgba(200,238,91,.6);}
.tmark{position:absolute;left:50%;top:50%;width:18px;height:18px;margin:-9px 0 0 -9px;border-radius:5px;background:#e74c3c;box-shadow:0 0 10px rgba(231,76,60,.8);}
.stopbtn{width:76px;height:76px;border-radius:50%;border:none;background:#e74c3c;color:#fff;font-weight:900;font-size:15px;cursor:pointer;box-shadow:0 8px 20px rgba(231,76,60,.35);}
.stopbtn:active{transform:scale(.94);}
.flash{animation:wflash .5s;}
@keyframes wflash{0%{box-shadow:inset 0 0 0 3px #e74c3c;}100%{box-shadow:none;}}
.bowl{position:relative;width:200px;height:150px;margin:6px auto;border-radius:0 0 90px 90px/0 0 70px 70px;border:2px solid #2b3f57;background:radial-gradient(ellipse at 50% 20%,#10202f,#0a1420);}
.fishy{position:absolute;width:16px;height:10px;border-radius:60% 40% 40% 60%;background:#f39c12;transition:left 1s cubic-bezier(.4,0,.2,1),top 1s cubic-bezier(.4,0,.2,1);}
.fdigits{font-size:34px;font-weight:800;letter-spacing:10px;color:var(--tt-uv);text-shadow:0 0 14px rgba(139,92,246,.7);}
.cbtn{width:46px;height:46px;border-radius:50%;border:2px solid var(--tt-border);cursor:pointer;}
.cbtn.black{background:#111;}.cbtn.blue{background:#2563eb;}.cbtn.yellow{background:#eab308;}
.glyphgrid{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin:6px 0;}
.gkey{min-height:52px;font-size:24px;border-radius:12px;border:1px solid var(--tt-border);background:rgba(255,255,255,.05);color:var(--tt-text);cursor:pointer;}
.gkey:active{background:rgba(200,238,91,.15);}
.numpad{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin:6px 0;}
.numpad .gkey{font-size:19px;font-weight:700;}
.paper{background:#efe9d8;color:#222;border-radius:10px;padding:14px;position:relative;text-align:start;min-height:90px;}
.paper .fgrade{position:absolute;top:8px;inset-inline-end:12px;font-size:44px;font-weight:900;color:#c0392b;transform:rotate(12deg);font-family:Georgia,serif;}
.paper .lines{color:#9a9483;font-size:11px;line-height:1.9;letter-spacing:2px;}
.mcard{display:inline-block;background:#0a0a0a;color:#eee;border:1px solid #333;border-radius:8px;padding:10px 22px;font-size:26px;font-weight:900;margin-top:10px;font-family:Georgia,serif;}
.nbpaper{background:#efe9d8;border-radius:10px;min-height:110px;display:flex;align-items:center;justify-content:center;gap:22px;font-size:40px;}
.nbpaper.blank{color:#c9c2ac;font-size:13px;}
.nbpaper .s1{color:#111;}.nbpaper .s2{color:#2563eb;}.nbpaper .s3{color:#d4a900;}
.bookbox{background:#3a2c22;border:1px solid #55402f;border-radius:10px;min-height:90px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:8px;color:#cbb9a6;font-weight:700;}
.bookbox.open{background:#efe9d8;color:#222;}
.bookbox .order{font-size:26px;letter-spacing:8px;color:#111;}
.lamparea{display:flex;align-items:center;justify-content:center;gap:14px;}
.lampbulb{width:64px;height:64px;border-radius:50%;background:#1c1c22;border:1px solid var(--tt-border);transition:all .4s;}
.lampbulb.small{background:#4a4420;box-shadow:0 0 18px rgba(232,180,100,.35);}
.lampbulb.big{background:#8a7226;box-shadow:0 0 34px rgba(232,180,100,.75);}
.lampbulb.uvon{background:#4c1d95;box-shadow:0 0 34px rgba(139,92,246,.85);}
.hintbar{position:sticky;bottom:0;margin:6px -22px -26px;padding:10px 22px 14px;background:linear-gradient(transparent,var(--tt-bg) 30%);}
.hintbar .chip{width:100%;}
.hrow{display:flex;align-items:center;gap:8px;padding:10px 4px;border-bottom:1px solid var(--tt-border);}
.hrow .hname{flex:1;font-size:14px;font-weight:700;}
.hrow .hname .dot{color:var(--tt-accent);}
.hrow .chip{flex:0 0 auto;min-height:36px;padding:0 12px;font-size:12.5px;}
.hrow .st{font-size:12px;color:var(--tt-muted);}

.deskobj{position:absolute;transform:translate(-50%,-50%);background:none;border:none;cursor:pointer;
  display:flex;flex-direction:column;align-items:center;gap:4px;color:inherit;font:inherit;padding:6px;
  min-width:44px;min-height:44px;touch-action:manipulation;transition:transform .15s,opacity .4s}
.deskobj:active{transform:translate(-50%,-50%) scale(.94)}
.deskobj-ico{font-size:40px;line-height:1;filter:drop-shadow(0 4px 6px rgba(0,0,0,.5))}
.deskobj-lbl{font-size:11px;opacity:.8;background:rgba(0,0,0,.35);padding:2px 8px;border-radius:10px;white-space:nowrap}
.deskobj.done .deskobj-ico{filter:drop-shadow(0 0 12px rgba(140,255,170,.5))}
.deskobj.locked{opacity:.4}
.p-widget{margin:10px 0}
.desk-scene{position:relative;width:100%;margin:8px 0;text-align:center}
.desk-board{position:relative;display:inline-block;width:100%;line-height:0}
.desk-img{display:block;width:100%;height:auto;border-radius:12px}
.deskspot{position:absolute;transform:translate(-50%,-50%);width:20%;aspect-ratio:1;max-width:110px;
  min-width:52px;min-height:52px;border-radius:50%;background:transparent;border:none;cursor:pointer;
  padding:0;touch-action:manipulation;-webkit-tap-highlight-color:transparent;z-index:2}
.deskspot:hover{background:radial-gradient(circle,rgba(255,179,71,.10),transparent 70%)}
.deskspot:active{background:radial-gradient(circle,rgba(255,179,71,.18),transparent 70%)}
.deskspot.done{background:radial-gradient(circle,rgba(140,255,170,.12),transparent 70%)}
.deskspot.locked{}
.deskreveal{width:100%;height:auto;display:block;animation:revealfade .5s ease-out}
@keyframes revealfade{from{opacity:0;transform:scale(.9)}to{opacity:1;transform:scale(1)}}
.deskspot.hasart{background:none}

.d3{--ds:92px;perspective:calc(var(--ds)*9);display:inline-block}
.d3-tilt{transform-style:preserve-3d;transform:rotateX(-14deg) rotateY(22deg)}
.d3-cube{position:relative;width:var(--ds);height:var(--ds);transform-style:preserve-3d;transition:transform .9s cubic-bezier(.18,.7,.3,1);margin:0 auto}
.d3-face{position:absolute;inset:0;border-radius:calc(var(--ds)*.16);display:grid;grid-template-columns:repeat(3,1fr);grid-template-rows:repeat(3,1fr);padding:calc(var(--ds)*.15);background:linear-gradient(150deg,#f2ede3,#d8cfc0 60%,#c3b8a5);border:1px solid rgba(0,0,0,.15);box-shadow:inset 2px 2px 6px rgba(255,255,255,.6),inset -3px -3px 8px rgba(0,0,0,.18)}
.d3-pip{width:calc(var(--ds)*.15);height:calc(var(--ds)*.15);border-radius:50%;align-self:center;justify-self:center;background:radial-gradient(circle at 35% 30%,#3a3a3a,#0c0c0c 75%);box-shadow:inset 0 1px 2px rgba(0,0,0,.6)}
.d3-f1{transform:rotateY(0deg) translateZ(calc(var(--ds)/2))}
.d3-f2{transform:rotateY(90deg) translateZ(calc(var(--ds)/2))}
.d3-f3{transform:rotateX(90deg) translateZ(calc(var(--ds)/2))}
.d3-f4{transform:rotateX(-90deg) translateZ(calc(var(--ds)/2))}
.d3-f5{transform:rotateY(-90deg) translateZ(calc(var(--ds)/2))}
.d3-f6{transform:rotateY(180deg) translateZ(calc(var(--ds)/2))}

.dice-bare{display:flex;justify-content:center;align-items:center;padding:24px 0;cursor:pointer;-webkit-tap-highlight-color:transparent;user-select:none}
.dice-bare:active{transform:scale(.97)}
</style>
</head>
<body>
<div class="dev">
  <div class="g"><span>מצב</span><button data-mode="player">שחקן</button><button data-mode="admin">אדמין</button></div>
  <div class="g"><span>שפה</span><button data-lang="he">עברית</button><button data-lang="en">EN</button></div>
  <div class="g" id="playerPick"><span>שחקן</span><button data-player="1">1</button><button data-player="2">2</button><button data-player="3">3</button></div>
  <div class="g"><span>שלב</span><button data-stepprev>‹</button><span id="stepLabel" style="min-width:1.2rem;text-align:center">1</span><button data-stepnext>›</button></div>
</div>
<div id="app"></div>
<div id="lightbox" class="lb"><img id="lbimg" alt=""/></div>
<script type="module">
import { initializeApp } from "https://www.gstatic.com/firebasejs/10.12.0/firebase-app.js";
import { getFirestore, doc, getDoc, onSnapshot } from "https://www.gstatic.com/firebasejs/10.12.0/firebase-firestore.js";
import { getFunctions, httpsCallable } from "https://www.gstatic.com/firebasejs/10.12.0/firebase-functions.js";
import { getAuth, onAuthStateChanged, signInWithEmailAndPassword } from "https://www.gstatic.com/firebasejs/10.12.0/firebase-auth.js";
import { firebaseConfig } from "./config.js";
const fbApp = initializeApp(firebaseConfig);
const db = getFirestore(fbApp);
const judge = httpsCallable(getFunctions(fbApp), "judge");
const auth = getAuth(fbApp);
const QS = new URLSearchParams(location.search);
const GAME_ID = QS.get("game") || "kidnapped-il";
const DEVFLAG = QS.get("dev") === "1";
window.__judge = (data) => judge({ gameId: GAME_ID, roomCode: ROOM_CODE, ...data }).then(r => (console.log(r.data), r.data));
const ROOM_CODE = QS.get("room") || QS.get("code") || "dev";
let SEAT_ID = null;
let CUST = {}, CUST_LOADED = false;
function cz(str){
  if (!str) return str;
  for (const f of ((S.game && S.game.customizable) || [])) {
    if (f.type !== "text") continue;
    str = str.split("{"+f.key+"}").join(CUST[f.key] || (f.default_key ? t(f.default_key) : "") || f.default || "");
  }
  return str;
}
function applyCustImages(){
  if (!S.game) return;
  for (const st of S.game.steps || []) for (const c of st.components || []) {
    if (c.cust_key && CUST[c.cust_key]) c.src = CUST[c.cust_key];
  }
}
let MY_NAME = "";
const S = { game:null, loc:{}, mode:"player", lang:"he", player:1, step:0, popup:null, elapsed:0, running:false, countdown:3, points:100, phase:null, seats:{}, flags:{}, prog:{}, hintsUsed:{}, hintOpen:false, dismissed:null, popupId:null };
const app = document.getElementById("app");
const lb = document.getElementById("lightbox");
const W = {};
const TRAINS = {};
let pausedVideo = null;
const t = (k)=>{
  const def = (S.game && S.game.defaultLanguage) || "he";
  const cur = S.loc[S.lang] && S.loc[S.lang][k];
  if(cur!==undefined) return cur;
  const d = S.loc[def] && S.loc[def][k];
  return d===undefined ? "" : d;
};
const vis = (c,n)=> c.visibleTo==="all" || (Array.isArray(c.visibleTo)&&c.visibleTo.includes(n));
const flag = (x)=> !!(S.flags && S.flags[x]);
const elid = (c)=> c.elementId || c.id;
function findComp(id){
  for(const st of (S.game && S.game.steps)||[]) for(const c of st.components||[]) if(c.id===id||c.elementId===id) return c;
  return null;
}
function blockerId(){
  const st=(S.game&&S.game.steps&&S.game.steps[S.step])||{};
  return (st.chain||[]).find(id=>!flag(id)) || null;
}
async function boot(){
  const g = await getDoc(doc(db,"games",GAME_ID));
  if(!g.exists()){ app.innerHTML="<p style='padding:2rem'>לא נמצא משחק. הריצו את סקריפט הזריעה תחילה.</p>"; return; }
  S.game=g.data();
  for(const l of ["he","en"]){ const s=await getDoc(doc(db,"games",GAME_ID,"locales",l)); S.loc[l]=s.exists()?s.data():{}; }
  tickCountdown();
}
function tickCountdown(){
  if(S.countdown===null){ render(); return; }
  render();
  if(S.countdown<=1){ setTimeout(()=>{ S.countdown=null; S.running=true; render(); },900); return; }
  setTimeout(()=>{ S.countdown--; tickCountdown(); },900);
}
setInterval(()=>{ if(S.running){ S.elapsed++; const el=document.getElementById("timer"); if(el) el.textContent=fmt(S.elapsed);} },1000);
function fmt(s){const m=Math.floor(s/60),ss=s%60,p=n=>String(n).padStart(2,"0");return p(m)+":"+p(ss);}
function submitEl(id,val,btn){
  if(btn) btn.disabled=true;
  return judge({ action:"submitElement", gameId:GAME_ID, roomCode:ROOM_CODE, elementId:id, value:val })
    .then((res)=>{ if(res.data.miss){ W["_flash_"+id]=Date.now(); } return res.data; })
    .catch((err)=>{ console.error("submitElement",id,err); })
    .finally(()=>{ if(btn) btn.disabled=false; render(); });
}
/* ---------- widget renderers ---------- */

const D3PIPS={1:[5],2:[1,9],3:[1,5,9],4:[1,3,7,9],5:[1,3,5,7,9],6:[1,3,4,6,7,9]};
const D3FACE={1:'d3-f1',2:'d3-f2',3:'d3-f3',4:'d3-f4',5:'d3-f5',6:'d3-f6'};
const D3TARGET={1:{x:0,y:0},2:{x:0,y:-90},3:{x:-90,y:0},4:{x:90,y:0},5:{x:0,y:90},6:{x:0,y:180}};
function d3FaceHTML(n){let c='';for(let i=1;i<=9;i++)c+=D3PIPS[n].includes(i)?'<div class="d3-pip"></div>':'<div></div>';return c;}
function d3CubeHTML(id,px,face){
  face=face||1;const t=D3TARGET[face];
  let faces='';for(let n=1;n<=6;n++)faces+='<div class="d3-face '+D3FACE[n]+'">'+d3FaceHTML(n)+'</div>';
  return '<div class="d3" style="--ds:'+px+'px"><div class="d3-tilt"><div class="d3-cube" id="'+id+'" data-face="'+face+'" style="transform:rotateX('+t.x+'deg) rotateY('+t.y+'deg)">'+faces+'</div></div></div>';
}

function wcomp(c, inter){
  const id=elid(c), done=flag(id), dis=inter?"":"disabled";
  const locked = c.enabledWhen && !flag(c.enabledWhen);
  if (c.showWhen && !flag(c.showWhen)) return "";
  const prog=(S.prog&&S.prog[id])||[];
  const fl=(W["_flash_"+id]&&Date.now()-W["_flash_"+id]<600)?"flash":"";
  const shell=(inner)=>`<div class="wdg ${done?'done':''} ${locked?'locked':''} ${fl}" id="w_${c.id}">
    <p class="wname">${t(c.name_key)} ${done?'✓':''}${locked?' 🔒':''}</p>${inner}
    ${c.caption_key?`<p class="wcap">${cz(t(c.caption_key))}</p>`:""}</div>`;
  const pips=(total)=>`<div class="pips">${Array.from({length:total},(_,i)=>`<span class="pip ${i<prog.length?'on':''}"></span>`).join("")}</div>`;

  if(c.widget==="stepper"){
    const p=c.params||{};
    if(!(id in W)) W[id]=(p.start??p.min??0);
    const shown=done?"1125":W[id];
    return shell(`<div class="readout ${done?'done':''}">${shown}<span style="font-size:13px;color:var(--tt-muted)"> ${p.unitKey?t(p.unitKey):""}</span></div>
      ${done?"":`<div class="row">
        <button class="chip" data-wstep="-1" data-el="${id}" ${dis}>−</button>
        <button class="chip" data-wstep="1" data-el="${id}" ${dis}>+</button>
        <button class="cta" data-wcommit data-el="${id}" ${dis}>ON</button></div>`}`);
  }
  if(c.widget==="voice"){
    const p=c.params||{};
    return shell(`<button class="chip" style="width:100%" data-voice="${p.say}" ${dis}>${t("el.audio.play")}</button>`);
  }
  if(c.widget==="gallery"){
    const p=c.params||{};
    const four=flag(p.show4When);
    const cells=(p.dates||[]).map(d=>`<div class="readout" style="font-size:17px">${d}</div>`).join("");
    const c4=four?`<div class="readout" style="font-size:17px;color:var(--tt-uv);border-color:rgba(139,92,246,.5)">${p.hidden4}</div>`
                 :`<div class="readout" style="font-size:17px;color:#3a3a44">· · ·</div>`;
    return shell(`<div style="display:grid;grid-template-columns:1fr 1fr;gap:8px">${cells}${c4}</div>`);
  }
  if(c.widget==="lamp"){
    if(!(id+"_st" in W)) W[id+"_st"]=0;
    const st=["off","small","big"][W[id+"_st"]];
    const uvOn=flag("uv");
    return shell(`<div class="lamparea">
      <div class="lampbulb ${uvOn?'uvon':st}"></div>
      <div style="display:flex;flex-direction:column;gap:8px">
        <button class="chip" data-lampcycle data-el="${c.id}" ${dis}>💡</button>
        <button class="chip" data-slider data-el="${id}" ${locked||uvOn?"disabled":dis}>◐ UV</button>
      </div></div>`);
  }
  if(c.widget==="symbols"){
    const p=c.params||{}, g=p.glyphs||{};
    const keys=Object.keys(g).map(k=>`<button class="gkey" data-wsubmit data-el="${id}" data-val="${k}" ${locked?"disabled":dis}>${g[k]}</button>`).join("");
    return shell(`${pips(p.total||6)}<div class="glyphgrid">${keys}</div>`);
  }
  if(c.widget==="artifact"){
    const p=c.params||{};
    return `<div class="wdg" style="opacity:.85"><button class="chip" style="width:100%;font-size:26px;background:none;border:none" data-artifact="${c.quip_key}">${p.emoji||"🎁"}</button></div>`;
  }
  if(c.widget==="roller"){
    const p=c.params||{}, seq=p.fixedSequence||[1,1,2,5];
    if(!(id in W)) W[id]=0;
    const face = W[id] ? seq[(W[id]-1)%seq.length] : 1;   // face shown for current roll
    // bare: the die itself is the roll target, no shell/label/caption/button
    return `<div class="dice-bare" data-roll data-el="${id}" role="button" aria-label="${t(c.name_key)}">${d3CubeHTML('cube_'+id, 104, face)}</div>`;
  }
  if(c.widget==="train"){
    const p=c.params||{}, chars=p.trackChars||[];
    if(!TRAINS[id]) TRAINS[id]={ start:Date.now(), lapSec:p.lapSec||9, chars };
    const spans=chars.map((ch,i)=>{const a=(-90+i*72)*Math.PI/180;const x=110+95*Math.cos(a),y=110+95*Math.sin(a);
      return `<span class="tchar" data-ci="${i}" style="left:${x}px;top:${y}px">${ch}</span>`;}).join("");
    return shell(`${pips(chars.length)}<div class="ttrack" data-train="${id}">${spans}<div class="tmark"></div></div>
      ${done?"":`<button class="stopbtn" data-trainstop data-el="${id}" ${dis}>STOP</button>`}`);
  }
  if(c.widget==="reveal"){
    const p=c.params||{};
    return shell(`<div style="font-size:44px">${p.emoji||"✨"}</div>`);
  }
  if(c.widget==="fish"){
    const p=c.params||{}, forms=p.formations||[];
    if(!(id+"_f" in W)) W[id+"_f"]=0;
    const form=forms[W[id+"_f"]];
    const POS={heart:[[32,32],[64,32],[48,48],[48,70]],square:[[30,32],[66,32],[30,66],[66,66]],triangle:[[48,26],[28,68],[68,68],[48,50]]};
    const dots=(POS[form]||[]).map(([x,y])=>`<div class="fishy" style="left:${x}%;top:${y}%"></div>`).join("");
    const inner=done
      ? `<div class="bowl" style="display:flex;align-items:center;justify-content:center"><span class="fdigits">${p.digits||""}</span></div>`
      : `<div class="bowl">${dots}</div>
         <div class="row" style="margin-top:10px">
           <button class="chip" data-form data-el="${id}" ${dis}>⟳ ${form}</button>
           ${(p.buttons||[]).map(b=>`<button class="cbtn ${b}" data-wsubmit data-el="${id}" data-val="${b}@${form}" ${dis}></button>`).join("")}
         </div>${pips(3)}`;
    return shell(inner);
  }
  if(c.widget==="book"){
    const p=c.params||{}, open=flag(c.showOpenWhen);
    const inner=open
      ? `<div class="bookbox open"><span style="font-size:12px">${t("el.book.clueLabel")}</span><span class="order">${(p.order||[]).map(k=>(p.glyphs||{})[k]||"?").join(" ")}</span></div>`
      : `<div class="bookbox">📕</div>`;
    return shell(inner);
  }
  if(c.widget==="testcard"){
    return shell(`<div class="paper"><span class="fgrade">F</span><div class="lines">7 × 8 = ____<br>12 + 29 = ____<br>90 ÷ 6 = ____</div></div><div class="mcard">M</div>`);
  }
  if(c.widget==="notebook"){
    const p=c.params||{}, on=flag(p.revealWhen);
    return shell(on
      ? `<div class="nbpaper"><span class="s1">♥</span><span class="s2">■</span><span class="s3">▲</span></div>`
      : `<div class="nbpaper blank">— — —</div>`);
  }
  if(c.widget==="clock"){
    const p=c.params||{};
    if(!(id+"_h" in W)){ const [h,m]=(p.start||"00:00").split(":").map(Number); W[id+"_h"]=h; W[id+"_m"]=m; }
    const pad=n=>String(n).padStart(2,"0");
    const shown=done?"08:10":pad(W[id+"_h"])+":"+pad(W[id+"_m"]);
    return shell(`<div class="readout ${done?'done':''}">${shown}</div>
      ${done?"":`<div class="row">
        <button class="chip" data-clk="h" data-d="1" data-el="${id}" ${locked?"disabled":dis}>H+</button>
        <button class="chip" data-clk="m" data-d="10" data-el="${id}" ${locked?"disabled":dis}>M+10</button>
        <button class="chip" data-clk="m" data-d="1" data-el="${id}" ${locked?"disabled":dis}>M+1</button>
        <button class="cta" data-clockset data-el="${id}" ${locked?"disabled":dis}>✓</button></div>`}`);
  }
  if(c.widget==="digits"){
    const p=c.params||{};
    if(!(id+"_b" in W)) W[id+"_b"]="";
    const keys=["7","8","9","4","5","6","1","2","3","C","0","="].map(k=>{
      const act=k==="C"?`data-calc="C"`:k==="="?`data-calcgo`:`data-calc="${k}"`;
      return `<button class="gkey" ${act} data-el="${id}" ${locked?"disabled":dis}>${k}</button>`;}).join("");
    return shell(`<div class="readout ${done?'done':''}" style="text-align:end;padding-inline:12px">${done?"3954607":(W[id+"_b"]||"0")}</div>
      ${done?"":`<div class="numpad">${keys}</div>`}`);
  }
  return "";
}
function comp(c,inter){
  const dis = inter ? "" : "disabled";
  if(c.type==="widget") return wcomp(c,inter);
  if(c.type==="title") return `<h1 class="c-title">${cz(t(c.text_key))}</h1>`;
  if(c.type==="subtitle") return `<p class="c-sub">${cz(t(c.text_key))}</p>`;
  if(c.type==="text"){ const v=cz(t(c.text_key)); return v ? `<p class="c-text">${v}</p>` : ""; }
  if(c.type==="image"){ const src=c.src||t(c.src_key); return src ? `<img class="c-img" src="${src}" alt=""/>` : ""; }
  if(c.type==="video"){
    const src=c.src||t(c.src_key); if(!src) return "";
    if(c.pauseImage) return `<video class="c-vid pv" src="${src}" data-reveal="${c.pauseImage}" autoplay muted loop playsinline preload="metadata"></video>`;
    return `<video class="c-vid" src="${src}" controls playsinline preload="metadata"></video>`;
  }
  if(c.type==="audio"){ const src=c.src||t(c.src_key); return src ? `<audio class="c-aud" src="${src}" controls preload="metadata"></audio>` : ""; }
  if(c.type==="pano"){ let src=c.src||t(c.src_key); if(src){ try{ const u=new URL(src, location.href); src = u.pathname + u.search; }catch(e){} } return src ? `<div class="c-pano" data-pano="${src}"></div>` : ""; }
  if(c.type==="warning") return `<p class="warn">${t(c.text_key)}</p>`;
  if(c.type==="rules"){ const it=t(c.items_key); const a=Array.isArray(it)?it:[]; return `<ul class="rules">${a.map(r=>`<li>${r}</li>`).join("")}</ul>`; }
  if(c.type==="cta") return `<button class="cta" data-action="${c.action||'advance'}" ${dis}>${t(c.label_key)}</button>`;
  if(c.type==="input"){
    const _hu=(S.hintsUsed&&S.hintsUsed[String(S.step)])||0;
    const hints=(c.hints||[]).map((h,i)=>`<button class="chip" data-hint="${h}" data-hintindex="${i}" ${i>_hu?"disabled":dis}>${t("popup.hint")} ${i+1}</button>`).join("");
    const submit=S.lang==='he'?'שלח':'Submit';
    const _need=(c.hints||[]).length, _used=(S.hintsUsed&&S.hintsUsed[String(S.step)])||0;
    const skipBtn=(_need>0&&_used>=_need)?`<button class="chip" data-skip ${dis}>${t("popup.skip")}</button>`:"";
    return `<div class="hints">${hints}${skipBtn}</div><input class="input" id="answer" autocomplete="off" autocorrect="off" autocapitalize="none" spellcheck="false" name="a-${Math.random().toString(36).slice(2)}" placeholder="${t(c.placeholder_key)}" ${dis}/><button class="cta" data-submit data-outcome="${c.outcome_key}" ${dis}>${submit}</button>`;
  }
  return "";
}
function hintSheet(){
  const st=S.game.steps[S.step]||{}, hot=blockerId();
  const mine=(st.components||[]).filter(c=>c.type==="widget"&&(c.hints||[]).length&&vis(c,S.player));
  mine.sort((a,b)=>(elid(a)===hot?-1:0)-(elid(b)===hot?-1:0));
  const rows=mine.map(c=>{
    const id=elid(c), used=(S.hintsUsed&&S.hintsUsed[id])||0, n=(c.hints||[]).length;
    const solved=flag(id), locked=c.enabledWhen&&!flag(c.enabledWhen);
    const chips=solved?`<span class="st">✓</span>`
      :locked?`<span class="st">🔒</span>`
      :(c.hints.map((h,i)=>`<button class="chip" data-elhint data-el="${id}" data-hintindex="${i}" data-hintkey="${h}" ${i>used?"disabled":""}>${t("popup.hint")} ${i+1}</button>`).join("")
        +(used>=n?`<button class="chip" data-elskip data-el="${id}">${t("popup.skip")}</button>`:""));
    return `<div class="hrow"><span class="hname">${id===hot&&!solved?'<span class="dot">●</span> ':''}${t(c.name_key)}</span>${chips}</div>`;
  }).join("");
  return `<div class="scrim" data-hintclose><div class="sheet hb"><span class="peak"></span>${rows||"<p class='c-sub'>—</p>"}</div></div>`;
}
function lobbyView(){
  const N = (S.game && S.game.N) || 3;
  const he = S.lang === "he";
  const seats = Object.entries(S.seats).map(([id, v]) => ({ id, ...v })).sort((a, b) => a.joinIndex - b.joinIndex);
  const me = S.seats[SEAT_ID];
  const rows = seats.map(v => `<p class="c-sub">${v.name} — ${he ? "שחקן" : "Player"} ${((v.joinIndex - 1) % N) + 1} ${v.ready ? "✅" : "⏳"}${v.id === SEAT_ID ? (he ? " (אני)" : " (me)") : ""}</p>`).join("") || `<p class="c-sub">${he ? "אף אחד עדיין" : "Nobody yet"}</p>`;
  const joinUi = me
    ? `<button class="cta" data-ready>${me.ready ? (he ? "בטל מוכנות" : "Not ready") : (he ? "אני מוכן!" : "Ready!")}</button>`
    : `<input class="input" id="joinName" value="${MY_NAME.replace(/"/g,"&quot;")}" placeholder="${he ? "השם שלך" : "Your name"}"/><button class="cta" data-join>${he ? "הצטרפות" : "Join"}</button>`;
  return `<div class="wrap"><div class="phone">${topbar()}<div class="body"><h1 class="c-title">${he ? "חדר" : "Room"} ${ROOM_CODE}</h1>${rows}${joinUi}${(S.isAdmin||S.buyerUid===SEAT_ID)?`<button class="chip" data-forcestart>${he ? "התחל בכל זאת (מנהל)" : "Force start (director)"}</button>`:""}</div></div></div>`;
}
function topbar(){
  return `<header class="topbar"><div class="brandside"><div class="logo"></div><div class="pl"><span class="nm">${MY_NAME||(S.lang==='he'?'מאיה':'Maya')}</span><span class="badge">${t("topbar.player")} ${S.player}</span></div></div><span class="timer" id="timer">${fmt(S.elapsed)}</span><div class="rightside"><div class="metaside"><span class="pts">${S.points} ${t("topbar.points")}</span><span class="stg">${t("topbar.stage")} ${S.step+1}</span></div></div></header>`;
}
function popupHtml(){
  const p=S.popup, glyph={hint:"✉️",win:"⭐",lose:"🚩"}[p.kind]||"✉️";
  if(p.comp){
    const ttl = p.noTitle ? "" : `<h2 class="p-title">${p.title||""}</h2>`;
    return `<div class="scrim" data-close><div class="sheet"><span class="peak"></span>${ttl}<div class="p-widget">${comp(p.comp,true)}</div><button class="cta" data-popcta>${p.cta}</button></div></div>`;
  }
  return `<div class="scrim" data-close><div class="sheet"><span class="peak"></span><div class="glyph">${glyph}</div><h2 class="p-title ${p.kind==='win'?'win':''}">${p.title}</h2>${p.body?`<p class="p-body">${p.body}</p>`:""}<button class="cta" data-popcta>${p.cta}</button></div></div>`;
}
function finaleView(){
  return `<div class="body"><h1 class="c-title" style="color:var(--tt-accent)">${t("screens.finale.title")}</h1>
    <div style="font-size:64px;text-align:center;margin:14px 0">🔓</div>
    <p class="c-text">${cz(t("screens.finale.body"))}</p></div>`;
}
function playerView(){
  const step=S.game.steps[S.step];
  const isBoard=step&&step.kind==="board";
  let inner;
  if(S.countdown!==null){
    inner=`<div class="body"><div class="cd"><p class="lbl">${t("countdown.getReady")}</p><div class="ring"><span class="num">${S.countdown}</span></div></div></div>`;
  } else if(isBoard&&flag("laptop")){
    inner=finaleView();
  } else {
    const mine=step.components.filter(c=>vis(c,S.player));
    const bar=isBoard?`<div class="hintbar"><button class="chip" data-hintboard>💡 ${S.lang==='he'?'רמזים':'Hints'}</button></div>`:"";
    if(step.layout==='desk'){
      const heads=mine.filter(c=>c.type!=='widget').map(c=>comp(c,true)).join("");
      const sceneSrc = step.scene ? (step.scene[S.player]||step.scene[String(S.player)]||"") : "";
      const spots=mine.filter(c=>c.type==='widget').map(c=>{
        const id=elid(c);
        if(c.showWhen && !flag(c.showWhen)) return "";   // hidden = truly absent until trigger
        if(c.x==null||c.y==null) return "";              // no coords = decoy/dressing, no hotspot
        const done=flag(id), locked=c.enabledWhen && !flag(c.enabledWhen);
        // reveal objects aren't in the base photo — their art rides on top as a PNG
        const revImg = c.revealSrc ? `<img class="deskreveal" src="${c.revealSrc}" alt="" draggable="false">` : "";
        const w = c.w!=null ? c.w : 20;   // hotspot width % (default 20)
        return `<button class="deskspot ${done?'done':''} ${locked?'locked':''} ${revImg?'hasart':''}" style="left:${c.x}%;top:${c.y}%;width:${w}%" data-deskobj="${c.id}" aria-label="${t(c.name_key)}">${revImg}</button>`;
      }).join("");
      const sceneImg = sceneSrc ? `<img class="desk-img" src="${sceneSrc}" alt="" draggable="false">` : "";
      const board = sceneSrc ? `<div class="desk-board">${sceneImg}${spots}</div>` : `<div class="desk-board">${spots}</div>`;
      inner=`<div class="body">${heads}<div class="desk-scene">${board}</div>${bar}</div>`;
    } else {
      inner=`<div class="body">${mine.map(c=>comp(c,true)).join("")||"<p class='c-sub'>—</p>"}${bar}</div>`;
    }
  }
  const uv=flag("uv")?"uv":"";
  return `<div class="wrap"><div class="phone ${uv}">${topbar()}${inner}${S.hintOpen?hintSheet():""}${S.popup?popupHtml():""}</div></div>`;
}
function adminView(){
  const step=S.game.steps[S.step], N=S.game.N;
  let cols="";
  for(let n=1;n<=N;n++){
    const mine=step.components.filter(c=>vis(c,n));
    const others=step.components.filter(c=>!vis(c,n));
    const body=mine.map(c=>comp(c,false)).join("")+others.map(c=>`<div class="hidden-note">${c.type} — ${S.lang==='he'?'מוסתר':'hidden'}</div>`).join("");
    cols+=`<div class="col"><h4>${t("topbar.player")} ${n}</h4><div class="cbody">${body||"—"}</div></div>`;
  }
  return `<div class="adminbar"><strong>${t("game.title")}</strong> · ${t("topbar.stage")} ${S.step+1}/${S.game.steps.length}</div><div class="grid">${cols}</div>`;
}
function initPanos(){ if(!window.pannellum) return; document.querySelectorAll(".c-pano").forEach(el=>{ if(el.dataset.init) return; el.dataset.init="1"; try{ pannellum.viewer(el,{type:"equirectangular",panorama:el.dataset.pano,autoLoad:true,showZoomCtrl:true,showFullscreenCtrl:true}); }catch(e){} }); }
function trainNow(id){
  const tr=TRAINS[id]; if(!tr) return null;
  const a=(((Date.now()-tr.start)/(tr.lapSec*1000))%1)*360-90;
  let best=-1,bd=999;
  tr.chars.forEach((_,i)=>{ const ca=-90+i*72; let d=Math.abs(((a-ca)%360+540)%360-180); if(d<bd){bd=d;best=i;} });
  return { idx:best, within:bd<=26, angle:a };
}
setInterval(()=>{
  for(const id of Object.keys(TRAINS)){
    const box=document.querySelector(`.ttrack[data-train="${id}"]`); if(!box) continue;
    const st=trainNow(id); if(!st) continue;
    const m=box.querySelector(".tmark"); const r=st.angle*Math.PI/180;
    if(m) m.style.transform=`translate(${95*Math.cos(r)}px,${95*Math.sin(r)}px)`;
    box.querySelectorAll(".tchar").forEach((el,i)=>el.classList.toggle("hot", st.within&&i===st.idx));
  }
},50);
function render(){ if(!S.game) return;
  document.documentElement.dir = S.lang==="he"?"rtl":"ltr";
  document.documentElement.lang = S.lang;
  document.getElementById("playerPick").style.display = S.mode==="player"?"":"none";
  document.getElementById("stepLabel").textContent = S.step+1;
  document.querySelectorAll("[data-mode]").forEach(b=>b.classList.toggle("on",b.dataset.mode===S.mode));
  document.querySelectorAll("[data-lang]").forEach(b=>b.classList.toggle("on",b.dataset.lang===S.lang));
  document.querySelectorAll("[data-player]").forEach(b=>b.classList.toggle("on",+b.dataset.player===S.player));
  if (S.phase === "lobby") { app.innerHTML = lobbyView(); return; }
  app.innerHTML = S.mode==="player" ? playerView() : adminView(); initPanos();
}
document.querySelector(".dev").insertAdjacentHTML("beforeend", '<button data-resetroom>↺ Reset</button>');
document.querySelector(".dev").addEventListener("click",(e)=>{
  const b=e.target.closest("button"); if(!b||!S.game)return;
  if(b.dataset.mode) S.mode=b.dataset.mode;
  if(b.dataset.lang) S.lang=b.dataset.lang;
  if(b.dataset.player) S.player=+b.dataset.player;
  if(b.hasAttribute("data-resetroom")){ judge({ action:"resetRoom", gameId: GAME_ID, roomCode: ROOM_CODE }).catch(e=>console.error(e)); return; }
  if(b.hasAttribute("data-stepprev")){ S.popup=null; S.step=Math.max(0,S.step-1); }
  if(b.hasAttribute("data-stepnext")){ S.popup=null; S.step=Math.min(S.game.steps.length-1,S.step+1); }
  render();
});
app.addEventListener("click",(e)=>{
  const pv=e.target.closest("video.pv");
  if(pv){ pv.pause(); pausedVideo=pv; document.getElementById("lbimg").src=pv.getAttribute("data-reveal"); lb.classList.add("open"); return; }
  const img=e.target.closest("img.c-img");
  if(img){ document.getElementById("lbimg").src=img.getAttribute("src"); lb.classList.add("open"); return; }
  const el=e.target.closest("[data-action],[data-skip],[data-hint],[data-submit],[data-popcta],[data-close],[data-join],[data-ready],[data-forcestart],[data-wstep],[data-wcommit],[data-wsubmit],[data-voice],[data-lampcycle],[data-slider],[data-roll],[data-trainstop],[data-form],[data-clk],[data-clockset],[data-calc],[data-calcgo],[data-artifact],[data-deskobj],[data-hintboard],[data-hintclose],[data-elhint],[data-elskip]"); if(!el)return;
  /* --- widget interactions --- */
  if(el.hasAttribute("data-wstep")){
    const id=el.dataset.el, c=findComp(id), p=(c&&c.params)||{};
    const delta=(p.step??1)*Number(el.dataset.wstep);
    W[id]=Math.min(p.max??Infinity,Math.max(p.min??-Infinity,(W[id]??0)+delta));
    render(); return;
  }
  if(el.hasAttribute("data-wcommit")){ submitEl(el.dataset.el, W[el.dataset.el], el); return; }
  if(el.hasAttribute("data-wsubmit")){ submitEl(el.dataset.el, el.dataset.val, el); return; }
  if(el.hasAttribute("data-voice")){ try{ const u=new SpeechSynthesisUtterance(el.dataset.voice); u.rate=.8; speechSynthesis.speak(u);}catch(err){} return; }
  if(el.hasAttribute("data-lampcycle")){ const c=findComp(el.dataset.el)||{}; const k=elid(c)+"_st"; W[k]=((W[k]||0)+1)%3; render(); return; }
  if(el.hasAttribute("data-slider")){ submitEl(el.dataset.el, "press", el); return; }
  if(el.hasAttribute("data-roll")){ const id=el.dataset.el; const comp=findComp(id); const seq=(comp&&comp.params&&comp.params.fixedSequence)||[1,1,2,5];
    W[id]=(W[id]||0)+1; const face=seq[(W[id]-1)%seq.length]; const cube=document.getElementById('cube_'+id);
    if(cube){ const t=D3TARGET[face]; const sx=(2+Math.floor(Math.random()*2))*360*(Math.random()<.5?1:-1); const sy=(2+Math.floor(Math.random()*2))*360*(Math.random()<.5?1:-1);
      cube.style.transition='transform .9s cubic-bezier(.18,.7,.3,1)'; cube.style.transform='rotateX('+(sx+t.x)+'deg) rotateY('+(sy+t.y)+'deg)';
      setTimeout(()=>{ cube.style.transition='none'; cube.style.transform='rotateX('+t.x+'deg) rotateY('+t.y+'deg)'; render(); }, 900); }
    else { render(); } return; }
  if(el.hasAttribute("data-trainstop")){
    const id=el.dataset.el, st=trainNow(id);
    const val=(st&&st.within)?TRAINS[id].chars[st.idx]:"_";
    submitEl(id, val, el); return;
  }
  if(el.hasAttribute("data-form")){ const id=el.dataset.el; W[id+"_f"]=((W[id+"_f"]||0)+1)%3; render(); return; }
  if(el.hasAttribute("data-clk")){
    const id=el.dataset.el, d=Number(el.dataset.d);
    if(el.dataset.clk==="h") W[id+"_h"]=((W[id+"_h"]||0)+d)%24;
    else W[id+"_m"]=((W[id+"_m"]||0)+d)%60;
    render(); return;
  }
  if(el.hasAttribute("data-clockset")){
    const id=el.dataset.el, pad=n=>String(n).padStart(2,"0");
    submitEl(id, pad(W[id+"_h"]||0)+":"+pad(W[id+"_m"]||0), el); return;
  }
  if(el.hasAttribute("data-calc")){ const id=el.dataset.el, k=el.dataset.calc;
    W[id+"_b"]=k==="C"?"":((W[id+"_b"]||"")+k).slice(0,9); render(); return; }
  if(el.hasAttribute("data-calcgo")){ const id=el.dataset.el; submitEl(id, W[id+"_b"]||"", el); return; }
  if(el.hasAttribute("data-artifact")){ S.popup={kind:"hint",title:"", body:cz(t(el.dataset.artifact)), cta:t("popup.close")}; S.popupId="local"+Date.now(); render(); return; }
  if(el.hasAttribute("data-deskobj")){ const step=S.game.steps[S.step]; const c=(step.components||[]).find(x=>x.id===el.dataset.deskobj); if(c){ const bare=(c.widget==='roller'); if(bare && c.params) W[elid(c)]=0; S.popup={kind:"hint",title:t(c.name_key),comp:c,cta:t("popup.close"),noTitle:bare}; S.popupId="desk"+c.id; render(); } return; }
  if(el.hasAttribute("data-hintboard")){ S.hintOpen=true; render(); return; }
  if(el.hasAttribute("data-hintclose")){ if(e.target===el){ S.hintOpen=false; render(); } return; }
  if(el.hasAttribute("data-elhint")){
    judge({ action:"hint", gameId:GAME_ID, roomCode:ROOM_CODE, elementId:el.dataset.el, hintIndex:Number(el.dataset.hintindex), hintKey:el.dataset.hintkey })
      .then((res)=>{ S.points=res.data.points; S.hintOpen=false; })
      .catch((err)=>{ console.error("hint failed",err); })
      .finally(()=>render());
    return;
  }
  if(el.hasAttribute("data-elskip")){
    el.disabled=true;
    judge({ action:"skipElement", gameId:GAME_ID, roomCode:ROOM_CODE, elementId:el.dataset.el })
      .then(()=>{ S.hintOpen=false; })
      .catch((err)=>{ console.error("skip failed",err); el.disabled=false; })
      .finally(()=>render());
    return;
  }
  /* --- existing paths --- */
  if(el.hasAttribute("data-join")){ const nm=((document.getElementById("joinName")||{}).value||"").trim(); if(!nm) return; judge({action:"join", gameId:GAME_ID, roomCode:ROOM_CODE, seatId:SEAT_ID, name:nm}).catch(err=>console.error("join failed",err)); return; }
  if(el.hasAttribute("data-ready")){ const me=S.seats[SEAT_ID]; judge({action:"ready", gameId:GAME_ID, roomCode:ROOM_CODE, seatId:SEAT_ID, ready:!(me&&me.ready)}).catch(err=>console.error("ready failed",err)); return; }
  if(el.hasAttribute("data-forcestart")){ judge({action:"forceStart", gameId:GAME_ID, roomCode:ROOM_CODE}).catch(err=>console.error("forceStart failed",err)); return; }
  if(el.hasAttribute("data-action")){ if(el.dataset.action==="advance") nextStep(); else if(el.dataset.action==="coupon"){ S.popup={kind:"win",title:"🎁",body:t("coupon.soon"),cta:t("popup.close")}; render(); } }
  else if(el.hasAttribute("data-skip")){ el.disabled=true; judge({ action:"skip", gameId: GAME_ID, roomCode: ROOM_CODE, stepId: String(S.step) }).catch((err)=>{ console.error("skip failed", err); el.disabled=false; }); }
  else if(el.hasAttribute("data-hint")){
    judge({ action:"hint", gameId: GAME_ID, roomCode: ROOM_CODE, stepId: String(S.step), hintIndex: Number(el.dataset.hintindex), hintKey: el.dataset.hint })
      .then((res)=>{ S.points = res.data.points; })
      .catch((err)=>{ console.error("hint charge failed", err); })
      .finally(()=>{ render(); });
  }
  else if(el.hasAttribute("data-submit")){
    const val=(document.getElementById("answer")||{}).value||"";
    el.disabled = true;
    judge({ action:"submit", gameId: GAME_ID, roomCode: ROOM_CODE, stepId: String(S.step), submission: val, outcomeKey: el.dataset.outcome }).then((res)=>{
    }).catch((err)=>{
      console.error("judge failed", err);
      S.popup = {kind:"lose",title:"!",body:"connection error — try again",cta:t("lose.cta")};
    }).finally(()=>{ el.disabled=false; render(); });
  }
  else if(el.hasAttribute("data-popcta")){ S.dismissed=S.popupId; S.popup=null; render(); }
  else if(el.hasAttribute("data-close")){ if(e.target===el){ S.dismissed=S.popupId; S.popup=null; render(); } }
});
lb.addEventListener("click",()=>{
  lb.classList.remove("open"); document.getElementById("lbimg").src="";
  if(pausedVideo){ try{ pausedVideo.play(); }catch(e){} pausedVideo=null; }
});
function nextStep(){ S.running=true; S.step=Math.min(S.game.steps.length-1,S.step+1); S.popup=null; render(); }
let roomStarted = 0;
document.head.insertAdjacentHTML("beforeend", `<style>
.ptfloat{position:fixed;top:70px;left:50%;transform:translateX(-50%);font-size:28px;font-weight:800;z-index:9999;pointer-events:none;animation:ptfl 1.6s ease-out forwards;}
.ptfloat.up{color:#2ecc71}.ptfloat.dn{color:#e74c3c}
@keyframes ptfl{0%{opacity:0;transform:translate(-50%,10px)}15%{opacity:1}100%{opacity:0;transform:translate(-50%,-50px)}}
</style>`);
function floatPoints(d){
  const el=document.createElement("div");
  el.className="ptfloat "+(d>0?"up":"dn");
  el.textContent=(d>0?"+":"")+d;
  document.body.appendChild(el);
  setTimeout(()=>el.remove(),1700);
}
let lastRoomStep = null, prevPoints = null;
const LANG_PARAM = QS.get("lang");
if (LANG_PARAM === "he" || LANG_PARAM === "en") S.lang = LANG_PARAM;
let appStarted = false;
function startApp(){
  if (appStarted) return; appStarted = true;
onSnapshot(doc(db, "rooms", ROOM_CODE), (snap) => {
  const r = snap.data(); S.hintsUsed=(r&&r.hintsUsed)||{}; if (!r) return;
  roomStarted = r.startedAt || 0;
  S.points = r.points;
  S.phase = r.phase || "play";
  S.seats = r.seats || {};
  S.flags = r.flags || {};
  S.prog = r.prog || {};
  S.buyerUid = r.buyerUid || null;
  if (r.instanceId && !CUST_LOADED) {
    CUST_LOADED = true;
    getDoc(doc(db, "instances", r.instanceId)).then(snap => {
      if (snap.exists()) { CUST = snap.data().customization || {}; applyCustImages(); render(); }
    }).catch(e => console.warn("customization load", e));
  }
  const mine = S.seats[SEAT_ID];
  if (mine) S.player = ((mine.joinIndex - 1) % ((S.game && S.game.N) || 3)) + 1;
  if (r.step !== undefined && r.step !== lastRoomStep) { lastRoomStep = r.step; S.step = r.step; }
  if (typeof prevPoints === "number" && r.points !== prevPoints) floatPoints(r.points - prevPoints);
  prevPoints = r.points;
  if (r.popup && r.popup.id !== S.dismissed) {
    S.popupId = r.popup.id;
    const p = r.popup;
    const solver = p.solver || (S.lang==='he'?'חבר צוות':'a teammate');
    const pbody = (k)=> (k?cz(t(k)):"").split("{player_name}").join(solver);
    S.popup = p.kind === "win" ? { kind:"win", title:t("win.title"), body:pbody(p.bodyKey), cta:t("win.cta") }
            : p.kind === "lose" ? { kind:"lose", title:t("lose.title"), body:t("lose.body"), cta:t("lose.cta") }
            : p.kind==="skip" ? { kind:"hint", title:t("popup.skipped"), body:pbody(p.bodyKey), cta:t("popup.close") } : { kind:"hint", title:t("popup.hint"), body:pbody(p.bodyKey), cta:t("popup.close") };
  } else if (r.popup && r.popup.id === S.dismissed) { S.popup = null; }
  render();
});
setInterval(() => {
  S.elapsed = roomStarted ? Math.floor((Date.now() - roomStarted) / 1000) : 0;
  const el = document.getElementById("timer");
  if (el) el.textContent = fmt(S.elapsed);
  if (roomStarted && Date.now() - roomStarted > 3*3600*1000 && !window.__expired){
    window.__expired = true; location.href = "/portal.html";
  }
}, 1000);
boot();
}
document.querySelector(".dev").style.display = "none";
function gameAuthView(){
  const he = S.lang === "he";
  app.innerHTML = `<div class="wrap"><div class="phone"><div class="body" style="padding-top:60px">
    <h1 class="c-title">${he ? "מתחברים ומשחקים" : "Sign in to play"}</h1>
    <input class="input" id="g_email" type="email" placeholder="Email" autocomplete="email"/>
    <input class="input" id="g_pass" type="password" placeholder="${he ? "סיסמה" : "Password"}" autocomplete="current-password"/>
    <button class="cta" id="g_signin">${he ? "כניסה" : "Sign in"}</button>
    <p class="c-sub" id="g_err" style="color:#ff7b7b"></p>
    <p class="c-sub">${he ? "אין חשבון עדיין? נרשמים בפורטל" : "No account yet? Sign up in the portal"} — <a href="/portal.html" style="color:#c8f542">TotemTime</a></p>
  </div></div></div>`;
  document.getElementById("g_signin").onclick = async () => {
    try { await signInWithEmailAndPassword(auth, document.getElementById("g_email").value.trim(), document.getElementById("g_pass").value); }
    catch(e){ document.getElementById("g_err").textContent = S.lang === "he" ? "האימייל או הסיסמה שגויים" : "Wrong email or password"; }
  };
}
onAuthStateChanged(auth, async (user) => {
  if (!user) { SEAT_ID = null; gameAuthView(); return; }
  SEAT_ID = user.uid;
  try {
    const u = await getDoc(doc(db, "users", user.uid));
    MY_NAME = (u.exists() && (u.data().nickname || u.data().fullName)) || user.email.split("@")[0];
  } catch(e){ MY_NAME = user.email.split("@")[0]; }
  try {
    const a = await getDoc(doc(db, "admins", user.uid));
    if (a.exists()){ S.isAdmin = true; document.querySelector(".dev").style.display = ""; }
  } catch(e){}
  if (DEVFLAG) document.querySelector(".dev").style.display = "";
  startApp();
});
</script>
</body>
</html>
