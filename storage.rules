rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // end-of-game selfies: each player writes only their own file; collage.jpg is written server-side
    match /instances/{instanceId}/photos/{uid} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid
                   && request.resource.size < 12 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null && request.auth.uid == uid;
    }
    match /instances/{instanceId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.resource.size < 60 * 1024 * 1024
                   && (request.resource.contentType.matches('image/.*')
                       || request.resource.contentType.matches('video/.*'));
      allow delete: if request.auth != null;
    }
    match /{allPaths=**} { allow read, write: if false; }
  }
}
